---
import "@fontsource/archivo/300.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/noto-sans-tc/300.css";
import "@fontsource/noto-sans-tc/400.css";
import "@fontsource/noto-sans-tc/500.css";
import "@fontsource/noto-sans-tc/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/tokens.css";
import "../build-anim/build-anim.css";
import {
  ENABLED as BUILD_ENABLED,
  MOBILE_BP,
  REPLAY_EVERY_LOAD,
  SCRUB_ENABLED,
  STORAGE_PREFIX,
} from "../build-anim/config";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import CareerWrappedFab from "../components/CareerWrappedFab.astro";

interface Props {
  title: string;
  description: string;
  /** 啟用建構動畫的頁面代碼（首頁 "home"、About "about"）；省略則不啟用。 */
  buildAnim?: string;
}

const { title, description, buildAnim } = Astro.props;
const buildKey = BUILD_ENABLED ? buildAnim : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ogImage = new URL(`${base}/og-image.png`, Astro.site ?? Astro.url.origin);
---

<html lang="zh-Hant">
  <head>
    {
      buildKey && (
        <script is:inline define:vars={{ buildKey, MOBILE_BP, STORAGE_PREFIX, REPLAY_EVERY_LOAD, SCRUB_ENABLED }}>
          // 必須在 <head> 最前面：主程式載入前就決定隱藏／鎖定，避免閃爍或被捲動。
          // 不可把 locked 寫死在 HTML，否則 JS 失敗時頁面會永遠鎖住。
          var r = document.documentElement;
          var played = false;
          try { played = sessionStorage.getItem(STORAGE_PREFIX + buildKey) === "1"; } catch (e) {}
          var debug = /[?&]debug/.test(location.search) || REPLAY_EVERY_LOAD;
          r.dataset.baPage = buildKey;
          r.classList.add("js", "ba-page");
          if (!SCRUB_ENABLED) r.classList.add("ba-noscrub");
          if ((played && !debug) || location.hash) r.classList.add("ba-skip");
          else if (window.innerWidth >= MOBILE_BP) r.classList.add("locked");
        </script>
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Nav build={!!buildKey} />
    <main>
      <slot />
    </main>
    <Footer build={!!buildKey} />
    <CareerWrappedFab />
    <BackToTop />
    <slot name="overlay" />
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script>
      const revealAll = () => {
        document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
          el.classList.add("is-visible");
        });
      };

      // Narrower than revealAll: only reveals elements already on screen,
      // so it can't preempt an element's own scroll-triggered entrance
      // further down the page (see the load-safety-net use below).
      const revealVisible = () => {
        document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add("is-visible");
          }
        });
      };

      if (typeof IntersectionObserver === "undefined") {
        // No IO support (or JS disabled at parse time): don't leave content invisible.
        revealAll();
      } else {
        const revealed = new Set<Element>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && !revealed.has(entry.target)) {
                entry.target.classList.add("is-visible");
                revealed.add(entry.target);
                observer.unobserve(entry.target);
              }
            }
          },
          // Low threshold: even tall blocks (e.g. long case-study body copy)
          // reveal as soon as any part enters view, instead of waiting for
          // 15% of a multi-thousand-pixel element to be on screen.
          { threshold: 0.01, rootMargin: "0px 0px -10% 0px" }
        );

        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

        // Safety net: if the observer never fires for some elements (e.g. a
        // stalled callback on some mobile browsers), reveal whatever is
        // already on screen shortly after load so copy is never stuck at
        // opacity: 0 — without also revealing sections further down the
        // page before the visitor has scrolled to them.
        window.addEventListener("load", () => setTimeout(revealVisible, 1200));
      }

      // bfcache restore: some mobile browsers restore the page from cache on
      // back/forward navigation without re-executing this script, which can
      // leave .reveal elements permanently invisible.
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) revealAll();
      });
    </script>
  </body>
</html>

<style>
  main {
    min-width: 0;
    max-width: 90rem;
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-5)) var(--page-padding-inline) 0;
  }

  @media (max-width: 1200px) {
    main {
      padding-top: calc(var(--nav-height) + var(--space-4));
    }
  }
</style>
