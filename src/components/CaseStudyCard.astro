---
import { Image } from "astro:assets";
import PlaceholderBlock from "./PlaceholderBlock.astro";
import type { ImageMetadata } from "astro";

interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  cover?: ImageMetadata;
}
const { slug, title, summary, tags, cover } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Force a line break right before the em-dash separator (rather than
// wherever the browser happens to wrap) so long two-part titles read as
// two deliberate lines instead of an arbitrary mid-word wrap.
const [titleHead, ...titleRest] = title.split("——");
const titleTail = titleRest.join("——");
---

<a class="feature" href={`${base}/work/${slug}`}>
  <span class="thumb">
    {cover ? (
      <Image
        class="cover-image"
        src={cover}
        alt=""
        width={1184}
        height={888}
        quality={90}
      />
    ) : (
      <PlaceholderBlock ratio="4 / 3" />
    )}
  </span>
  <span class="body">
    <span class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </span>
    <h2>
      {titleHead}
      {titleTail && (
        <>
          <br />
          ——{titleTail}
        </>
      )}
    </h2>
    <p class="summary">{summary}</p>
  </span>
</a>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .thumb {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: #f9f9f9;
    transition: box-shadow var(--transition-hover);
  }

  .feature:hover .thumb {
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-text), transparent 88%);
  }

  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .feature:hover .cover-image {
    transform: scale(1.05);
  }

  .body {
    display: block;
    flex: 1;
    padding: var(--space-3) 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .tag {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #797979;
    background: #f9f9f9;
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  h2 {
    font-size: 1.5rem; /* 24px */
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.45;
    margin-bottom: var(--space-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-hover);
  }

  .feature:hover h2 {
    color: var(--color-text-secondary);
  }

  .summary {
    color: var(--color-text-secondary);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 40em) {
    .tag {
      font-size: 0.875rem; /* 14px */
    }

    .summary {
      font-size: 1rem; /* 16px */
    }
  }
</style>
