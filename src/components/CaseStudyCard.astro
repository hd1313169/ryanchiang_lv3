---
import { Image } from "astro:assets";
import PlaceholderBlock from "./PlaceholderBlock.astro";
import ThemedImage from "./ThemedImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  slug: string;
  order: number;
  title: string;
  subtitle: string;
  summary: string;
  tags: string[];
  cover?: ImageMetadata;
  coverDark?: ImageMetadata;
}
const { slug, order, title, subtitle, summary, tags, cover, coverDark } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ordinal = String(order).padStart(2, "0");

// Force a line break right before the em-dash separator (rather than
// wherever the browser happens to wrap) so long two-part titles read as
// two deliberate lines instead of an arbitrary mid-word wrap.
const [titleHead, ...titleRest] = title.split("——");
const titleTail = titleRest.join("——");
---

<a class="feature" href={`${base}/work/${slug}`}>
  <span class="thumb">
    {cover && coverDark ? (
      <ThemedImage class="cover-image" light={cover} dark={coverDark} alt="" width={800} height={600} />
    ) : cover ? (
      <Image class="cover-image" src={cover} alt="" width={800} height={600} />
    ) : (
      <PlaceholderBlock ratio="4 / 3" />
    )}
  </span>
  <span class="body">
    <span class="text">
      <span class="title-col">
        <span class="meta-row">
          <span class="ordinal">{ordinal}</span>
          <span class="subtitle">{subtitle}</span>
        </span>
        <h2>
          {titleHead}
          {titleTail && (
            <>
              <br />
              ——{titleTail}
            </>
          )}
        </h2>
      </span>
      <span class="tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </span>
      <p class="summary">{summary}</p>
    </span>
  </span>
</a>

<style>
  .feature {
    display: flex; /* horizontal card layout */
    gap: var(--space-5);
    align-items: center;
    text-decoration: none;
    padding: var(--space-6) var(--space-4);
    transition: background-color var(--transition-hover);
  }

  .feature:hover {
    background-color: var(--color-block-bg);
  }

  /* Cards sit flush against each other inside the shared outer border
     (which already closes off the first and last rows); a hairline divider
     between cards is all that's needed here. */
  .feature:not(:first-child) {
    border-top: 1px solid var(--color-border);
  }

  .thumb {
    /* flex-basis 0 + proportional grow/shrink keeps this at a fixed 36%
       share of the row's available width at every size, instead of
       flex-basis percentages (which drift towards 50/50 as free space
       gets distributed equally by two flex-grow: 1 tracks). */
    display: block;
    flex: 36 36 0%;
    min-width: 0;
    overflow: hidden; /* clips the zoomed image on hover to this box */
    border-radius: 2px;
  }

  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .feature:hover .cover-image {
    transform: scale(1.05);
  }

  .body {
    container-type: inline-size;
    display: block;
    flex: 64 64 0%;
    min-width: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .tag {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 0.8125rem; /* 13px */
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .text {
    display: block;
  }

  .title-col {
    display: block;
    min-width: 0;
    margin-bottom: var(--space-3);
  }

  .meta-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 8px;
    margin-bottom: var(--space-1);
  }

  .ordinal {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 1.125rem; /* 18px */
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--color-text-secondary);
  }

  h2 {
    font-size: 1.5625rem; /* 25px */
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-hover);
  }

  .feature:hover h2 {
    color: var(--color-text-secondary);
  }

  .subtitle {
    font-size: 1rem; /* 16px */
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-top: 0;
  }

  .summary {
    color: var(--color-text-secondary);
    font-weight: 300;
    font-size: 1rem; /* 16px */
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Below this container width, a side-by-side row squeezes the title/tags
     onto too few characters per line — fall back to the original stacked
     (thumbnail-on-top) card instead. */
  @container work-list (max-width: 34rem) {
    .feature {
      display: block;
    }

    .thumb {
      margin-bottom: var(--space-3);
    }
  }

  @media (max-width: 960px) {
    .ordinal,
    .subtitle {
      font-size: 1rem; /* 16px */
    }

    .tag {
      font-size: 0.75rem; /* 12px */
    }
  }
</style>
