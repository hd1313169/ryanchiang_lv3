---
import PlaceholderBlock from "./PlaceholderBlock.astro";

interface Props {
  slug: string;
  order: number;
  title: string;
  summary: string;
  tags: string[];
}
const { slug, title, summary, tags } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a class="feature" href={`${base}/work/${slug}`}>
  <span class="thumb">
    <PlaceholderBlock ratio="16 / 9" />
  </span>
  <span class="body">
    <span class="meta-row">
      <span class="tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </span>
    </span>
    <span class="text">
      <h2>{title}</h2>
      <p class="summary">{summary}</p>
    </span>
  </span>
</a>

<style>
  .feature {
    display: flex; /* horizontal card layout */
    gap: var(--space-4);
    align-items: center;
    text-decoration: none;
  }

  .thumb {
    /* flex-basis 0 + proportional grow/shrink keeps this at a fixed 53%
       share of the row's available width at every size, instead of
       flex-basis percentages (which drift towards 50/50 as free space
       gets distributed equally by two flex-grow: 1 tracks). */
    display: block;
    flex: 53 53 0%;
    min-width: 0;
  }

  .body {
    container-type: inline-size;
    display: block;
    flex: 47 47 0%;
    min-width: 0;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .text {
    display: block;
  }

  h2 {
    /* Scales with the text column's own width (not the viewport), so it
       never outgrows the space next to the thumbnail; hard-capped to 2
       lines regardless of title length. */
    font-size: clamp(1rem, 0.75rem + 1.6cqi, 1.1875rem);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-hover);
  }

  .feature:hover h2 {
    color: var(--color-text-secondary);
  }

  .summary {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* Below this container width, a side-by-side row squeezes the title/tags
     onto too few characters per line — fall back to the original stacked
     (thumbnail-on-top) card instead. */
  @container work-list (max-width: 34rem) {
    .feature {
      display: block;
    }

    .thumb {
      margin-bottom: var(--space-3);
    }
  }
</style>
