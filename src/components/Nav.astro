---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = [
  { label: "Works", href: `${base}/` },
  { label: "About", href: `${base}/about` },
];
const currentPath = Astro.url.pathname;
---

<nav class="nav" aria-label="主要導覽">
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">Resume</a>
    </li>
  </ul>
</nav>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  a {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  a:hover,
  a[aria-current="page"] {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (max-width: 1080px) {
    ul {
      flex-direction: row;
      gap: var(--space-3);
    }
  }
</style>
