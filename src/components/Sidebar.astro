---
import Nav from "./Nav.astro";
import Illustration from "./Illustration.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<aside class="sidebar">
  <div class="identity">
    <a class="wordmark" href={`${base}/`}>Ryan Chiang</a>
    <p class="tagline">
      <span class="role">UI/UX Designer</span>
      <span class="line">在想要怎麼做之前，我會先確認我們在解決對的問題。</span>
    </p>
  </div>

  <Nav />

  <div class="illustration-slot">
    <Illustration width={240} />
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-4) var(--page-padding-inline) var(--space-5);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wordmark {
    display: block;
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-text-secondary);
  }

  .tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    max-width: 26ch;
  }

  .tagline .role,
  .tagline .line {
    display: block;
  }

  .tagline .line {
    margin-top: var(--space-1);
  }

  .illustration-slot {
    display: flex;
    justify-content: flex-start;
  }

  .illustration-slot :global(.illustration-swap) {
    max-width: 180px;
  }

  @media (max-width: 1200px) {
    .illustration-slot {
      display: none;
    }
  }

  @media (max-width: 1200px) {
    .sidebar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-2) var(--page-padding-inline);
    }

    .identity {
      gap: var(--space-1);
    }

    .wordmark {
      font-size: var(--text-md);
    }

    .tagline {
      display: none;
    }
  }
</style>
