---
// The sidebar's illustrated figure. Two frames cross-fade into each other,
// advancing to the next frame every time the page has been scrolled past
// another fixed-height step (looping back and forth as the reader scrolls
// up or down), rather than animating on a timer. Each frame also has a
// light/dark pair; the theme (data-theme on <html>) picks which of the
// pair is visible for whichever frame the scroll step has made active.
import { Image } from "astro:assets";
import frame1Light from "../assets/illustrations/sidebar-illustration-1.png";
import frame1Dark from "../assets/illustrations/sidebar-illustration-1-dark.png";
import frame2Light from "../assets/illustrations/sidebar-illustration-2.png";
import frame2Dark from "../assets/illustrations/sidebar-illustration-2-dark.png";

interface Props {
  width?: number;
  class?: string;
}

const { width = 220, class: className } = Astro.props;
const steps = [
  { light: frame1Light, dark: frame1Dark },
  { light: frame2Light, dark: frame2Dark },
];
---

<span class:list={["illustration-swap", className]}>
  {
    steps.map((step, i) => (
      <>
        <Image
          class:list={["illustration-frame", "is-light", i === 0 && "is-active"]}
          data-step={i}
          src={step.light}
          alt=""
          width={width * 2}
          quality={100}
          loading={i === 0 ? "eager" : "lazy"}
        />
        <Image
          class:list={["illustration-frame", "is-dark", i === 0 && "is-active"]}
          data-step={i}
          src={step.dark}
          alt=""
          width={width * 2}
          quality={100}
          loading={i === 0 ? "eager" : "lazy"}
        />
      </>
    ))
  }
</span>

<style>
  .illustration-swap {
    display: block;
    position: relative;
  }

  .illustration-frame {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .illustration-frame:first-child {
    /* Establishes the box's height; the rest stack on top of it. */
    position: relative;
  }

  .illustration-frame:not(:first-child) {
    position: absolute;
    inset: 0;
  }

  .illustration-frame.is-active.is-light {
    opacity: 1;
  }

  :global([data-theme="dark"]) .illustration-frame.is-active.is-light {
    opacity: 0;
  }

  :global([data-theme="dark"]) .illustration-frame.is-active.is-dark {
    opacity: 1;
  }
</style>

<script>
  // Shared across every <Illustration> instance on the page (sidebar +
  // mobile intro both use this component) — Astro only injects this
  // module once per page regardless of how many instances render.
  const STEP = 920; // px of scroll per frame change

  const groups = new Map<string, HTMLElement[]>();
  document.querySelectorAll<HTMLElement>(".illustration-swap").forEach((swap, groupIndex) => {
    const frames = Array.from(swap.querySelectorAll<HTMLElement>(".illustration-frame"));
    if (frames.length) groups.set(String(groupIndex), frames);
  });

  if (groups.size) {
    const applyFrame = () => {
      const index = Math.floor(window.scrollY / STEP);
      for (const frames of groups.values()) {
        const stepCount = new Set(frames.map((frame) => frame.dataset.step)).size;
        const activeStep = String(index % stepCount);
        frames.forEach((frame) => frame.classList.toggle("is-active", frame.dataset.step === activeStep));
      }
    };

    applyFrame();
    window.addEventListener("scroll", applyFrame, { passive: true });
  }
</script>
