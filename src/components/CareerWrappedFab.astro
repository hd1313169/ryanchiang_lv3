---
---

<a
  class="career-fab"
  href="/career-wrapped.html"
  target="_blank"
  rel="noopener"
  aria-label="年度回顧（在新分頁開啟）"
>
  <span class="career-fab__icon" aria-hidden="true">✦</span>
  <span class="career-fab__label">年度回顧</span>
</a>

<script>
  // Flip the label to white while it sits over a dark surface (footer, dark
  // sections, images with dark backgrounds). We look at what is painted under
  // the label's center and walk up to the first opaque background color.
  const fab = document.querySelector<HTMLAnchorElement>(".career-fab");
  const label = fab?.querySelector<HTMLElement>(".career-fab__label");

  if (fab && label) {
    const bgLuminance = (start: Element | null): number | null => {
      for (let el = start; el; el = el.parentElement) {
        const m = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
        if (!m) continue;
        const [r, g, b, a = "1"] = m;
        if (Number(a) < 0.5) continue;
        return (0.2126 * +r + 0.7152 * +g + 0.0722 * +b) / 255;
      }
      return null;
    };

    let queued = false;
    const update = () => {
      queued = false;
      const rect = label.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const under = document
        .elementsFromPoint(x, y)
        .find((el) => !fab.contains(el) && !el.closest(".back-to-top"));
      const lum = bgLuminance(under ?? null);
      fab.classList.toggle("is-on-dark", lum !== null && lum < 0.4);
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    window.addEventListener("pageshow", schedule);
    schedule();
  }
</script>

<style>
  /* Sits directly above BackToTop (3rem button + gap), at a fixed position
     regardless of whether BackToTop is currently shown. Its center is pinned
     to BackToTop's center (right offset + half of 3rem) via translateX(50%),
     so both buttons stay horizontally centered whatever the label width. */
  .career-fab {
    position: fixed;
    right: calc(var(--space-3) + 1.5rem);
    bottom: calc(var(--space-3) + 3rem + var(--space-3));
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 3rem;
    min-height: 3rem;
    padding: 0.25rem;
    color: var(--color-text);
    text-decoration: none;
    transform: translateX(50%);
    transition: opacity var(--transition-hover);
  }

  .career-fab:hover {
    opacity: 0.6;
  }

  .career-fab:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .career-fab__icon {
    font-size: 2.75rem;
    line-height: 1;
    /* Gradient fill in the career-wrapped page palette (cobalt → pink → butter). */
    background: linear-gradient(135deg, #2b3be6 0%, #ff5a8a 55%, #ffb000 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #2b3be6; /* fallback where background-clip:text is unsupported */
    /* Entrance on each page load: the star spins in once, then the label follows. */
    animation: career-fab-icon-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  .career-fab__label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    transition: color var(--transition-hover);
    animation: career-fab-label-in 0.4s ease-out 0.9s both;
  }

  .career-fab.is-on-dark .career-fab__label {
    color: #fff;
  }

  .career-fab.is-on-dark:focus-visible {
    outline-color: #fff;
  }

  @keyframes career-fab-icon-in {
    from {
      opacity: 0;
      transform: rotate(-360deg) scale(0.4);
    }
    to {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  @keyframes career-fab-label-in {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 48em) {
    .career-fab {
      right: calc(var(--space-5) + 1.5rem);
      bottom: calc(var(--space-5) + 3rem + var(--space-3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-fab {
      transition: none;
    }

    .career-fab__icon,
    .career-fab__label {
      animation: none;
    }
  }
</style>
