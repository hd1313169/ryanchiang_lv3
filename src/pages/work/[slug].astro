---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const caseStudies = await getCollection("case-studies");
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, subtitle, summary, order, intro, mainDuties, team, timeline, tools } = entry.data;
const ordinal = String(order).padStart(2, "0");

const allCaseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allCaseStudies.findIndex((c) => c.id === entry.id);
const next = allCaseStudies[(currentIndex + 1) % allCaseStudies.length];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// "研究與洞察" has no fixed heading text of its own — it always points to
// whichever h2 immediately follows 專案背景, since that heading's wording
// differs per case study.
const topHeadings = headings.filter((h) => h.depth === 2);
const introIndex = topHeadings.findIndex((h) => h.slug === "專案背景");
const researchHeading = introIndex >= 0 ? topHeadings[introIndex + 1] : undefined;

const sections = [
  { href: "#專案背景", label: "專案背景" },
  ...(researchHeading ? [{ href: `#${researchHeading.slug}`, label: "研究與洞察" }] : []),
  { href: "#設計決策", label: "設計決策" },
  { href: "#設計成果", label: "設計成果" },
  { href: "#心得與反思", label: "心得與反思" },
];
---

<BaseLayout title={`${title} — Ryan Chiang`} description={summary}>
  <article class="case-study">
    <header class="reveal">
      <div class="header-body">
        <div class="kicker">
          <span class="ordinal">{ordinal}</span>
          <span class="kicker-label">{subtitle}</span>
        </div>

        <h1>{title}</h1>

        <p class="intro" set:html={intro} />

        <dl class="meta">
          <div><dt>主要職責</dt><dd>{mainDuties}</dd></div>
          <div><dt>團隊成員</dt><dd>{team}</dd></div>
          <div><dt>專案時程</dt><dd>{timeline}</dd></div>
          <div><dt>使用工具</dt><dd>{tools}</dd></div>
        </dl>
      </div>
    </header>

    <nav class="section-nav-float" aria-label="本篇章節">
      {sections.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>

    <div class="prose reveal">
      <Content />
    </div>

    <a class="next-case reveal" href={`${base}/work/${next.id}`}>
      <span class="next-label">下一篇案例</span>
      <span class="next-title">{next.data.title}</span>
    </a>
  </article>
</BaseLayout>

<style>
  .case-study {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding-block: var(--space-4) var(--space-6);
  }

  header {
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .header-body {
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .ordinal {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .kicker-label {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  h1 {
    font-size: var(--text-xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .intro {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.85;
    margin-bottom: var(--space-4);
  }

  .intro :global(strong) {
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .meta > div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .meta > div:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .meta dt {
    flex: 0 0 6rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .meta dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* Floating chapter index — only shown once there's enough spare width
     beside the centered article column for it not to crowd the text. */
  .section-nav-float {
    display: none;
  }

  @media (min-width: 90em) {
    .section-nav-float {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      position: fixed;
      top: 22%;
      right: var(--space-4);
      z-index: 2;
    }
  }

  .section-nav-float a {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    text-align: right;
    padding-right: var(--space-2);
    border-right: 2px solid var(--color-border);
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .section-nav-float a:hover {
    color: var(--color-text);
    border-right-color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-top: var(--space-5);
    margin-bottom: var(--space-1);
    scroll-margin-top: var(--space-3);
  }

  /* 次標題 — either a one-line subtitle directly under a section's h2, or
     one of several subsection headings grouped under 設計決策. */
  .prose :global(h3) {
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-text);
    margin-top: var(--space-5);
    margin-bottom: var(--space-1);
  }

  .prose :global(h2 + h3) {
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .prose :global(p) {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.85;
    margin-bottom: var(--space-1);
  }

  .prose :global(ul) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0 0 var(--space-2);
    padding: 0;
    counter-reset: list-counter;
  }

  .prose :global(li) {
    counter-increment: list-counter;
    position: relative;
    padding-left: 1.75rem;
    font-weight: 300;
    line-height: 1.8;
  }

  .prose :global(li::before) {
    content: counter(list-counter) ".";
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 300;
    color: var(--color-text);
  }

  /* Number picks up the same weight as whatever follows it — bold when the
     item leads with a bold label, otherwise plain like ordinary body text. */
  .prose :global(li:has(> strong:first-child)::before) {
    font-weight: 600;
  }

  .prose :global(strong),
  .prose :global(b) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid var(--color-text);
    background: color-mix(in srgb, var(--color-text), var(--color-bg) 98%);
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
  }

  .prose :global(blockquote p:first-child) {
    margin-bottom: var(--space-1);
  }

  /* A short sequence of steps (e.g. an AI-assisted workflow): three tall
     cards in a row on desktop, connected by a rightward arrow; on mobile
     they fall back to wide cards stacked vertically with a downward arrow. */
  .prose :global(.workflow-cards) {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    margin: var(--space-3) 0 var(--space-4);
  }

  .prose :global(.workflow-card) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 10rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-bottom: 3px solid var(--color-text);
    border-radius: 4px;
    padding: var(--space-4) var(--space-3);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.85;
  }

  .prose :global(.workflow-card strong) {
    display: block;
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .prose :global(.workflow-arrow) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-2);
    color: var(--color-text-secondary);
    font-size: 1.25rem;
    line-height: 1;
  }

  @media (max-width: 40em) {
    .prose :global(.workflow-cards) {
      grid-template-columns: 1fr;
    }

    .prose :global(.workflow-card) {
      min-height: 0;
    }

    .prose :global(.workflow-arrow) {
      padding: var(--space-1) 0;
      transform: rotate(90deg);
    }
  }

  /* 痛點 / 設計挑戰 / 我的任務 table (a single data row) renders as three
     side-by-side cards instead of a literal table row. Multi-row tables
     (e.g. a competitor comparison grid) keep normal table layout below. */
  .prose :global(table:has(tbody tr:only-of-type)) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--space-2);
    width: 100%;
    margin: var(--space-4) 0;
  }

  .prose :global(table:has(tbody tr:only-of-type) thead),
  .prose :global(table:has(tbody tr:only-of-type) tbody),
  .prose :global(table:has(tbody tr:only-of-type) tr) {
    display: contents;
  }

  .prose :global(table:has(tbody tr:only-of-type) th) {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-align: left;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: var(--space-2) var(--space-3) 0.25rem;
  }

  .prose :global(table:has(tbody tr:only-of-type) td) {
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.7;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: none;
    border-radius: 0 0 4px 4px;
    padding: 0.25rem var(--space-3) var(--space-3);
  }

  @media (max-width: 40em) {
    .prose :global(table:has(tbody tr:only-of-type)) {
      grid-template-columns: 1fr;
      row-gap: var(--space-2);
    }

    .prose :global(table:has(tbody tr:only-of-type) th:nth-child(1)) {
      grid-row: 1;
    }
    .prose :global(table:has(tbody tr:only-of-type) th:nth-child(2)) {
      grid-row: 3;
    }
    .prose :global(table:has(tbody tr:only-of-type) th:nth-child(3)) {
      grid-row: 5;
    }
    .prose :global(table:has(tbody tr:only-of-type) td:nth-child(1)) {
      grid-row: 2;
    }
    .prose :global(table:has(tbody tr:only-of-type) td:nth-child(2)) {
      grid-row: 4;
    }
    .prose :global(table:has(tbody tr:only-of-type) td:nth-child(3)) {
      grid-row: 6;
    }
  }

  /* Any other table (e.g. a multi-row competitor comparison grid) keeps a
     conventional layout, scrollable on narrow viewports. */
  .prose :global(table:not(:has(tbody tr:only-of-type))) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: var(--space-4) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(table:not(:has(tbody tr:only-of-type)) th),
  .prose :global(table:not(:has(tbody tr:only-of-type)) td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
    line-height: 1.6;
  }

  .prose :global(table:not(:has(tbody tr:only-of-type)) th) {
    font-weight: 500;
    background: color-mix(in srgb, var(--color-text), var(--color-bg) 96%);
    white-space: nowrap;
  }

  .next-case {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: var(--space-1);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-text);
    text-decoration: none;
  }

  .next-case:hover .next-title {
    color: var(--color-text-secondary);
  }

  .next-label {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .next-title {
    font-size: var(--text-md);
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--transition-hover);
  }

  @media (max-width: 28em) {
    .meta dt {
      flex-basis: 4.5rem;
    }
  }
</style>
