---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const caseStudies = await getCollection("case-studies");
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, subtitle, summary, order, intro, mainDuties, team, timeline, tools } = entry.data;
const ordinal = String(order).padStart(2, "0");

const allCaseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allCaseStudies.findIndex((c) => c.id === entry.id);
const next = allCaseStudies[(currentIndex + 1) % allCaseStudies.length];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// "研究與洞察" has no fixed heading text of its own — it always points to
// whichever h2 immediately follows 專案背景, since that heading's wording
// differs per case study.
const topHeadings = headings.filter((h) => h.depth === 2);
const introIndex = topHeadings.findIndex((h) => h.slug === "專案背景");
const researchHeading = introIndex >= 0 ? topHeadings[introIndex + 1] : undefined;

const sections = [
  { href: "#專案背景", label: "專案背景" },
  ...(researchHeading ? [{ href: `#${researchHeading.slug}`, label: "研究與洞察" }] : []),
  { href: "#設計決策", label: "設計決策" },
  { href: "#設計成果", label: "設計成果" },
  { href: "#心得與反思", label: "心得與反思" },
];
---

<BaseLayout title={`${title} — Ryan Chiang`} description={summary}>
  <article class="case-study">
    <header class="reveal">
      <div class="header-body">
        <div class="kicker">
          <span class="ordinal">{ordinal}</span>
          <span class="kicker-label">{subtitle}</span>
        </div>

        <h1>{title}</h1>

        <p class="intro" set:html={intro} />

        <dl class="meta">
          <div><dt>主要職責</dt><dd>{mainDuties}</dd></div>
          <div><dt>團隊成員</dt><dd>{team}</dd></div>
          <div><dt>專案時程</dt><dd>{timeline}</dd></div>
          <div><dt>使用工具</dt><dd>{tools}</dd></div>
        </dl>
      </div>
    </header>

    <nav class="section-nav-float" aria-label="本篇章節">
      {sections.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>

    <div class="prose">
      <Content />
    </div>

    <p class="disclaimer reveal">（本文所有圖片與資料皆經過處理，僅用於展示設計不涉及任何商業資訊。）</p>

    <a class="next-case reveal" href={`${base}/work/${next.id}`}>
      <span class="next-label">下一篇案例</span>
      <span class="next-title">{next.data.title}</span>
    </a>
  </article>
</BaseLayout>

<script define:vars={{ researchSlug: researchHeading?.slug ?? null }}>
  if (researchSlug) {
    const researchEl = document.getElementById(researchSlug);
    researchEl?.classList.add("section-divider");
  }

  // Reveal each top-level block of the article (every heading, paragraph,
  // list, table, custom card group, etc.) individually as it scrolls into
  // view, rather than fading the whole chapter in at once — a single long
  // chapter (e.g. 設計決策) would otherwise finish revealing the moment its
  // heading appears, leaving everything below it static while scrolling.
  const proseEl = document.querySelector(".prose");
  if (proseEl) {
    const targets = Array.from(proseEl.children);
    targets.forEach((el) => el.classList.add("case-section"));

    const revealAll = () => {
      targets.forEach((el) => el.classList.add("is-visible"));
    };

    if (typeof IntersectionObserver === "undefined") {
      revealAll();
    } else {
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              sectionObserver.unobserve(entry.target);
            }
          }
        },
        // Deliberately lenient: fire as soon as any part of a block is on
        // screen (no shrunk bottom margin) so blocks near the end of the
        // page — where there isn't much scroll room left to satisfy a
        // stricter margin — still reveal normally.
        { threshold: 0, rootMargin: "0px 0px 0px 0px" }
      );
      targets.forEach((el) => sectionObserver.observe(el));

      // Safety net matching the site-wide .reveal behavior: force everything
      // visible shortly after load in case the observer never fires.
      window.addEventListener("load", () => setTimeout(revealAll, 1200));
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) revealAll();
      });
    }
  }

  const navLinks = document.querySelectorAll(".section-nav-float a");
  if (navLinks.length) {
    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el) => el !== null);

    const setActive = (id) => {
      navLinks.forEach((link) => {
        link.classList.toggle("active", decodeURIComponent(link.hash.slice(1)) === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "0% 0% -70% 0%", threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .case-study {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding-block: var(--space-4) var(--space-6);
  }

  /* Below 90em there's no longer spare width beside the centered column for
     the floating chapter index to sit in without crowding the text, so
     reserve room for it on the right. */
  @media (min-width: 48em) and (max-width: 89.99em) {
    .case-study {
      padding-right: var(--space-6);
    }
  }

  header {
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .header-body {
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .ordinal {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .kicker-label {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  h1 {
    font-size: var(--text-xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .intro {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.85;
    margin-bottom: var(--space-4);
  }

  .intro :global(strong) {
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .meta > div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .meta > div:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .meta dt {
    flex: 0 0 6rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .meta dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* Floating chapter index. */
  .section-nav-float {
    display: none;
  }

  @media (min-width: 48em) {
    .section-nav-float {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      position: fixed;
      top: 22%;
      right: var(--space-4);
      z-index: 2;
    }
  }

  .section-nav-float a {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    text-align: right;
    padding-right: var(--space-2);
    border-right: 2px solid var(--color-border);
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .section-nav-float a:hover {
    color: var(--color-text);
    border-right-color: var(--color-text);
  }

  .section-nav-float a.active {
    color: var(--color-text);
    font-weight: 700;
    border-right-color: var(--color-text);
  }

  .prose :global(.case-section) {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 500ms ease, transform 500ms ease;
  }

  .prose :global(.case-section.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .prose :global(.case-section) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .prose :global(h2) {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    scroll-margin-top: var(--space-3);
  }

  /* 次標題 — either a one-line subtitle directly under a section's h2, or
     one of several subsection headings grouped under 設計決策. */
  .prose :global(h3) {
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-text);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :global(h2 + h3) {
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
  }

  /* Divides the article into its five major sections (專案背景 /
     研究與洞察 / 設計決策 / 設計成果 / 心得與反思). 研究與洞察 sometimes
     spans two h2 headings — .section-divider is added only to the first
     one via script, since the pair shouldn't be split by a rule. */
  .prose :global(h2[id="設計決策"]),
  .prose :global(h2[id="設計成果"]),
  .prose :global(h2[id="心得與反思"]),
  .prose :global(h2.section-divider) {
    margin-top: var(--space-7);
  }

  .prose :global(p) {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.85;
    margin-bottom: var(--space-1);
  }

  .prose :global(ul) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0 0 var(--space-2);
    padding: 0;
  }

  .prose :global(ol) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0 0 var(--space-2);
    padding-left: 1.25em;
  }

  .prose :global(li) {
    position: relative;
    font-weight: 300;
    line-height: 1.8;
  }

  .prose :global(strong),
  .prose :global(b) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid var(--color-text);
    background: color-mix(in srgb, var(--color-text), var(--color-bg) 98%);
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
  }

  .prose :global(blockquote p:first-child) {
    margin-bottom: var(--space-1);
  }

  /* A short sequence of steps (e.g. an AI-assisted workflow): three tall
     cards in a row on desktop, connected by a rightward arrow; on mobile
     they fall back to wide cards stacked vertically with a downward arrow. */
  .prose :global(.workflow-cards) {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    margin: var(--space-3) 0 var(--space-4);
  }

  .prose :global(.workflow-card) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 10rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-bottom: 3px solid var(--color-text);
    border-radius: 4px;
    padding: var(--space-4) var(--space-3);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.85;
  }

  .prose :global(.workflow-card strong) {
    display: block;
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .prose :global(.workflow-arrow) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-2);
    color: var(--color-text-secondary);
    font-size: 1.25rem;
    line-height: 1;
  }

  @media (max-width: 40em) {
    .prose :global(.workflow-cards) {
      grid-template-columns: 1fr;
    }

    .prose :global(.workflow-card) {
      min-height: 0;
    }

    .prose :global(.workflow-arrow) {
      padding: var(--space-1) 0;
      transform: rotate(90deg);
    }
  }

  /* Three findings, each with a title above a problem/resolution card
     pair connected by a rightward arrow; the three items stack vertically.
     On mobile the arrow rotates to point down. */
  .prose :global(.contrast-cards) {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-2);
    margin: var(--space-3) 0 var(--space-4);
  }

  .prose :global(.contrast-title) {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .prose :global(.contrast-pair) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
  }

  .prose :global(.contrast-card) {
    display: flex;
    flex-direction: row;
    align-items: center;
    column-gap: var(--space-2);
    min-height: 4.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-1) var(--space-3);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .prose :global(.contrast-card--left) {
    color: var(--color-text-secondary);
    border-left: 3px solid color-mix(in srgb, var(--color-text-secondary), var(--color-bg) 45%);
  }

  .prose :global(.contrast-card--right) {
    border-left: 3px solid #22c55e;
  }

  .prose :global(.contrast-icon) {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .prose :global(.contrast-icon--question) {
    background: color-mix(in srgb, var(--color-text-secondary), var(--color-bg) 45%);
  }

  .prose :global(.contrast-icon--check) {
    background: #22c55e;
  }

  .prose :global(.contrast-icon svg) {
    width: 11px;
    height: 11px;
  }

  .prose :global(.contrast-arrow) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-2);
    color: var(--color-text-secondary);
    font-size: 1.25rem;
    line-height: 1;
  }

  @media (max-width: 40em) {
    .prose :global(.contrast-pair) {
      grid-template-columns: 1fr;
    }

    .prose :global(.contrast-card) {
      min-height: 0;
    }

    .prose :global(.contrast-arrow) {
      padding: var(--space-1) 0;
      transform: rotate(90deg);
    }
  }

  /* 痛點 / 設計挑戰 / 我的任務 table (a single data row) renders as three
     side-by-side cards instead of a literal table row. Multi-row tables
     (e.g. a competitor comparison grid) keep normal table layout below. */
  .prose :global(table:has(tbody tr:only-of-type)) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--space-4);
    width: 100%;
    margin: var(--space-4) 0;
  }

  .prose :global(table:has(tbody tr:only-of-type) thead),
  .prose :global(table:has(tbody tr:only-of-type) tbody),
  .prose :global(table:has(tbody tr:only-of-type) tr) {
    display: contents;
  }

  .prose :global(table:has(tbody tr:only-of-type) th) {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-align: left;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: var(--space-2) var(--space-3) 0.25rem;
  }

  .prose :global(table:has(tbody tr:only-of-type) td) {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.7;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text);
    border-top: none;
    border-radius: 0 0 4px 4px;
    padding: 0.25rem var(--space-3) var(--space-3);
  }

  @media (max-width: 40em) {
    .prose :global(table:has(tbody tr:only-of-type)) {
      grid-template-columns: 1fr;
      row-gap: var(--space-2);
    }

    .prose :global(table:has(tbody tr:only-of-type) th:nth-child(1)) {
      grid-row: 1;
    }
    .prose :global(table:has(tbody tr:only-of-type) th:nth-child(2)) {
      grid-row: 3;
    }
    .prose :global(table:has(tbody tr:only-of-type) th:nth-child(3)) {
      grid-row: 5;
    }
    .prose :global(table:has(tbody tr:only-of-type) td:nth-child(1)) {
      grid-row: 2;
    }
    .prose :global(table:has(tbody tr:only-of-type) td:nth-child(2)) {
      grid-row: 4;
    }
    .prose :global(table:has(tbody tr:only-of-type) td:nth-child(3)) {
      grid-row: 6;
    }
  }

  /* A side-by-side image pair (e.g. a before/after comparison) sitting on
     a light backdrop, used to break up long text sections in the prose. */
  .prose :global(.image-pair) {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .prose :global(.image-pair figure) {
    flex: 0 1 auto;
    min-width: 0;
    margin: 0;
  }

  .prose :global(.image-pair img) {
    display: block;
    height: 340px;
    width: auto;
    max-width: 100%;
    border-radius: 4px;
  }

  .prose :global(.image-pair figcaption) {
    margin-top: var(--space-1);
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-secondary);
  }

  @media (max-width: 40em) {
    .prose :global(.image-pair) {
      flex-direction: column;
    }

    .prose :global(.image-pair img) {
      height: auto;
      width: 100%;
    }
  }

  /* A side-by-side pair of dark-canvas assets (e.g. phone-mockup GIFs)
     sitting inside one shared black card, wide gap between them so each
     still reads as its own unit. */
  .prose :global(.image-pair-dark) {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-7);
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-5);
    background: #000;
    border-radius: 4px;
  }

  .prose :global(.image-pair-dark figure) {
    flex: 0 1 260px;
    min-width: 0;
    margin: 0;
  }

  .prose :global(.image-pair-dark img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .prose :global(.image-pair-dark figcaption) {
    padding: var(--space-2) 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    color: #ffffff;
  }

  @media (max-width: 40em) {
    .prose :global(.image-pair-dark) {
      flex-direction: column;
      align-items: center;
    }

    .prose :global(.image-pair-dark figure) {
      flex: 0 1 auto;
      width: 100%;
      max-width: 260px;
    }
  }

  /* A paragraph running alongside a supporting screenshot (text left, image
     right) instead of stacked full-width — used when the copy is short
     enough to sit level with the image. */
  .prose :global(.split-media) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    margin: var(--space-4) 0;
  }

  /* Directly under a heading, fall back to the heading's own margin-bottom
     instead of stacking this block's larger top margin on top of it. */
  .prose :global(h2 + .split-media),
  .prose :global(h3 + .split-media) {
    margin-top: 0;
  }

  .prose :global(.split-media > p),
  .prose :global(.split-media .split-text) {
    flex: 1 1 0;
    min-width: 0;
  }

  .prose :global(.split-media > p) {
    margin-bottom: 0;
  }

  .prose :global(.split-media .split-text p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(.split-media img.split-image),
  .prose :global(.split-media video.split-image) {
    flex: 1 1 0;
    min-width: 0;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  /* Narrower variant: the media takes a smaller share of the row than the
     text (aspect ratio unchanged — width:100% of a smaller flex-basis). */
  .prose :global(.split-media img.split-image--narrow),
  .prose :global(.split-media video.split-image--narrow) {
    flex: 0 1 35%;
    max-width: 35%;
  }

  /* Vertically center the text and image instead of top-aligning — for use
     when the two panes end up different heights. */
  .prose :global(.split-media.split-media--center) {
    align-items: center;
  }

  /* Stacked variant: text on top, media below (instead of side by side),
     with the media held to a fixed share of the column's width rather
     than running full-bleed. Goes full width once the column itself is
     narrow enough (tablet and below) that a partial-width media block
     would feel cramped. */
  .prose :global(.split-media.split-media--stacked) {
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .prose :global(.split-media--stacked .split-text) {
    flex: none;
    width: 100%;
  }

