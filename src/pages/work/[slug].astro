---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderBlock from "../../components/PlaceholderBlock.astro";

export async function getStaticPaths() {
  const caseStudies = await getCollection("case-studies");
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, tags, order, ndaNote, role, scope, collaboration, status, showcaseItems } =
  entry.data;
const ordinal = String(order).padStart(2, "0");

const allCaseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allCaseStudies.findIndex((c) => c.id === entry.id);
const next = allCaseStudies[(currentIndex + 1) % allCaseStudies.length];

const sections = [
  { href: "#專案背景", label: "背景" },
  { href: "#設計決策", label: "決策" },
  { href: "#成果", label: "成果" },
  { href: "#反思", label: "反思" },
];
---

<BaseLayout title={`${title} — Ryan Chiang`} description={summary}>
  <article class="case-study">
    <header class="reveal">
      <div class="rail">
        <span class="ordinal">{ordinal}</span>
        <span class="vertical-label">Case Study</span>
      </div>

      <div class="header-body">
        <h1>{title}</h1>

        <dl class="meta">
          <div><dt>角色</dt><dd>{role}</dd></div>
          <div><dt>責任範疇</dt><dd>{scope}</dd></div>
          <div><dt>協作</dt><dd>{collaboration}</dd></div>
          <div><dt>狀態</dt><dd>{status}</dd></div>
        </dl>

        <nav class="section-nav" aria-label="本篇章節">
          {sections.map((s) => <a href={s.href}>{s.label}</a>)}
        </nav>

        {ndaNote && <p class="nda">NDA 說明：{ndaNote}</p>}
      </div>
    </header>

    <div class="prose reveal">
      <Content />
    </div>

    <section class="showcase reveal">
      <h2>設計展示</h2>
      <div class="showcase-grid">
        {
          showcaseItems.map((item) => (
            <PlaceholderBlock caption={`${item.title} — ${item.description}`} />
          ))
        }
      </div>
    </section>

    <a class="next-case reveal" href={`/work/${next.id}`}>
      <span class="next-label">下一篇案例</span>
      <span class="next-title">{next.data.title}</span>
    </a>
  </article>
</BaseLayout>

<style>
  .case-study {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding-block: var(--space-4) var(--space-6);
  }

  header {
    display: flex;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-text);
    margin-bottom: var(--space-4);
  }

  .rail {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-1);
  }

  .ordinal {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .header-body {
    min-width: 0;
    flex: 1;
  }

  h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-3);
  }

  .meta dt {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .meta dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .section-nav {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-nav a {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
  }

  .section-nav a:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .nda {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background: var(--color-block-bg);
    padding: var(--space-2);
    border-radius: 2px;
  }

  .prose :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    scroll-margin-top: var(--space-3);
  }

  .prose :global(p) {
    font-size: var(--text-base);
    line-height: 1.85;
    margin-bottom: var(--space-2);
  }

  .prose :global(ul) {
    margin-bottom: var(--space-2);
    padding-left: 1.2em;
  }

  .prose :global(li) {
    line-height: 1.8;
  }

  .showcase {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-text);
  }

  .showcase h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .next-case {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-text);
    text-decoration: none;
  }

  .next-case:hover .next-title {
    color: var(--color-text-secondary);
  }

  .next-label {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .next-title {
    font-size: var(--text-md);
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--transition-hover);
  }

  @media (max-width: 32em) {
    header {
      gap: var(--space-2);
    }
  }
</style>
