---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);

const tagline = "UI/UX Designer，專注在把複雜的問題梳理清楚，做出有依據的設計決策。";
---

<BaseLayout title="Ryan Chiang" description={tagline}>
  <section class="work-list reveal" aria-label="作品列表">
    {
      caseStudies.map((entry) => (
        <CaseStudyCard
          slug={entry.id}
          order={entry.data.order}
          title={entry.data.title}
          subtitle={entry.data.subtitle}
          summary={entry.data.summary}
          tags={entry.data.tags}
          cover={entry.data.cover}
          coverDark={entry.data.coverDark}
        />
      ))
    }
  </section>
</BaseLayout>

<style>
  .work-list {
    container-type: inline-size;
    container-name: work-list;
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Cancel main's own padding-top so the left/right border runs flush up
       to the top of the page through the blank space above the first card
       — but no border-top here: that horizontal line only appears once the
       first card starts (see .feature's own border-top), not at the very
       top of the page. */
    margin-top: calc(-1 * var(--space-5));
    padding-top: var(--space-6);
    /* Cancel the footer's own margin-top so the border runs flush down to
       the footer, but keep the same visual breathing room by moving it
       inside the box as padding instead of just deleting the whitespace. */
    margin-bottom: calc(-1 * var(--space-6));
    padding-bottom: var(--space-7);
    border-inline: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* Below this width, BaseLayout stacks the sidebar above main instead of
     beside it (see BaseLayout.astro's matching breakpoint), and a
     MobileIntro block sits between main and the footer. Bleeding the box's
     margins to reach "the top of the page" or "the footer" no longer means
     what it does on desktop — there's real stacked content above, and the
     footer isn't the very next element below — so drop the bleed and use
     plain, non-negative spacing instead. */
  @media (max-width: 1200px) {
    .work-list {
      margin-top: var(--space-4);
      padding-top: 0;
      margin-bottom: var(--space-6);
      padding-bottom: 0;
    }
  }

  /* Beyond this width, BaseLayout collapses the sidebar and main into a
     shared grid cell (the sidebar overlays main rather than sitting in its
     own column) — see BaseLayout.astro's matching breakpoint. A full-width
     work-list would then render underneath the overlaid sidebar, so cap and
     center it again here, same as before it went full-bleed. */
  @media (min-width: 99em) {
    .work-list {
      width: auto;
      max-width: var(--content-max-width);
      margin-inline: auto;
    }
  }
</style>
