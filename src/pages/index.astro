---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);

const tagline = "UI/UX Designer，專注在把複雜的問題梳理清楚，做出有依據的設計決策。";
---

<BaseLayout title="Ryan Chiang" description={tagline}>
  <section class="work-list reveal" aria-label="作品列表">
    {
      caseStudies.map((entry) => (
        <CaseStudyCard
          slug={entry.id}
          order={entry.data.order}
          title={entry.data.title}
          subtitle={entry.data.subtitle}
          summary={entry.data.summary}
          tags={entry.data.tags}
          cover={entry.data.cover}
          coverDark={entry.data.coverDark}
        />
      ))
    }
  </section>
</BaseLayout>

<style>
  .work-list {
    container-type: inline-size;
    container-name: work-list;
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Plain, non-bleeding whitespace on both sides — the border only spans
       the list itself, not the gaps around it. margin-top is tuned so the
       border lines up with the sidebar wordmark (see Sidebar.astro). */
    margin-top: var(--space-3);
    margin-bottom: var(--space-7);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 1200px) {
    .work-list {
      margin-top: var(--space-4);
      margin-bottom: var(--space-6);
    }
  }

  /* Beyond this width, BaseLayout collapses the sidebar and main into a
     shared grid cell (the sidebar overlays main rather than sitting in its
     own column) — see BaseLayout.astro's matching breakpoint. A full-width
     work-list would then render underneath the overlaid sidebar, so cap and
     center it again here, same as before it went full-bleed. */
  @media (min-width: 99em) {
    .work-list {
      width: auto;
      max-width: var(--content-max-width);
      margin-inline: auto;
    }
  }
</style>
