---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import heroIllustration1 from "../assets/illustrations/hero-1.png";
import heroIllustration2 from "../assets/illustrations/hero-2.png";
import notionWorkflowCover from "../assets/photos/cover-notion-workflow.jpg";
import worktimeToolCover from "../assets/photos/cover-worktime-tool.png";

const caseStudies = (await getCollection("case-studies")).sort(
  (a, b) => Number(b.id) - Number(a.id)
);

const sideProjects = [
  {
    title: "Notion 專案績效管理模板",
    summary:
      "一個提供中小型團隊自動化管理的 Notion 模板，共 8 個關聯資料庫分為三層。以關聯關係與公式邏輯串聯，讓績效計算從複雜試算表變成自動化工具。",
    href: "https://honey-agate-c33.notion.site/5904b56cf7778266860b012c8da88402",
    cover: notionWorkflowCover,
    tags: ["Notion", "自動化流程"],
  },
  {
    title: "複合收入薪資管理工具",
    summary:
      "為非月薪工作者或小型工作室設計的薪資計算工具，可自訂時薪、計件等多種計薪項目，即時計算每日、每週與每月薪資總計，支援 CSV 匯出，以 AI 協作開發完成。",
    href: "https://hd1313169.github.io/partime/",
    cover: worktimeToolCover,
    tags: ["AI 開發", "Web App"],
  },
];

const tagline = "UI/UX Designer，專注在把複雜的問題梳理清楚，做出有依據的設計決策。";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resumeHref = "https://www.cake.me/ryanchiang_13";
---

<BaseLayout title="Ryan Chiang" description={tagline}>
  <section class="hero reveal" aria-label="自我介紹">
    <div class="hero-text">
      <p class="hero-eyebrow">UI/UX Designer</p>
      <h1 class="hero-title">Hi！我是 <span class="latin">Ryan</span></h1>
      <p class="hero-headline">以邏輯思考拆解複雜問題，轉化成清晰直覺的介面設計。</p>
      <div class="hero-body">
        <p>
          4年 Web、SAAS使用者體驗與介面設計的實務經驗，
          擅長將複雜需求轉化為可落地的產品與系統介面。經歷橫跨整合行銷、證券業、空間租借服務、室內設計...等客製化系統專案。負責建立使用行為、系統邏輯與技術限制三者之間的橋樑，並轉化成清晰直覺的使用體驗設計。
        </p>
        <p>
          目前專注於 AI 協作設計流程、大型資料與複雜產品的體驗設計。持續研究新技術加速驗證與迭代的過程，讓設計職能成為產品推進的核心。
        </p>
      </div>
      <div class="hero-actions">
        <a class="hero-btn hero-btn--primary" href={`${base}/about`}>關於我</a>
        <a class="hero-btn hero-btn--secondary" href={resumeHref} target="_blank" rel="noopener noreferrer">
          履歷
          <svg class="hero-btn-icon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
            <path
              d="M4.5 11.5l7-7M5.5 4.5h6v6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
    <div class="hero-illustration">
      <div class="hero-illustration-frame">
        <Image src={heroIllustration1} alt="" width={480} class="hero-illustration-img is-active" />
        <Image
          src={heroIllustration2}
          alt=""
          width={480}
          class="hero-illustration-img hero-illustration-img--overlay"
        />
      </div>
    </div>
  </section>

  <section class="work-section">
    <div class="work-heading">
      <span class="work-icon" aria-hidden="true"></span>
      <h2>精選專案</h2>
      <span class="work-rule" aria-hidden="true"></span>
    </div>

    <div class="work-list" aria-label="作品列表">
      {
        caseStudies.map((entry) => (
          <div class="work-card reveal">
            <CaseStudyCard
              slug={entry.id}
              title={entry.data.title}
              summary={entry.data.summary}
              tags={entry.data.tags}
              cover={entry.data.cover}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-row">
    <div class="section-row-inner">
      <div class="section-heading reveal">
        <span class="section-icon" aria-hidden="true"></span>
        <h2>個人專案</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="side-projects">
        {
          sideProjects.map((project) => (
            <li class="reveal">
              <a class="side-project" href={project.href} target="_blank" rel="noopener noreferrer">
                <span class="side-project-thumb">
                  <Image
                    class="side-project-cover"
                    src={project.cover}
                    alt=""
                    width={1184}
                    height={888}
                    fit="contain"
                    quality={90}
                  />
                </span>
                <span class="side-project-body">
                  <span class="side-project-tags">
                    {project.tags.map((tag) => (
                      <span class="side-project-tag">{tag}</span>
                    ))}
                  </span>
                  <h3 class="side-project-title">
                    <span class="title-highlight">{project.title}</span>
                  </h3>
                  <p class="side-project-summary">{project.summary}</p>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const wrap = document.querySelector(".hero-illustration");

  if (wrap) {
    const imgs = Array.from(wrap.querySelectorAll(".hero-illustration-img"));
    let autoIndex = 0;
    let hovering = false;
    let intervalId: number | undefined;

    const render = () => {
      const activeIndex = hovering ? 1 : autoIndex;
      imgs.forEach((img, i) => img.classList.toggle("is-active", i === activeIndex));
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const start = () => {
      if (reduceMotion || intervalId !== undefined) return;
      intervalId = window.setInterval(() => {
        autoIndex = autoIndex === 0 ? 1 : 0;
        if (!hovering) render();
      }, 6000);
    };

    const stop = () => {
      if (intervalId !== undefined) {
        window.clearInterval(intervalId);
        intervalId = undefined;
      }
    };

    render();
    start();

    wrap.addEventListener("mouseenter", () => {
      hovering = true;
      render();
    });

    wrap.addEventListener("mouseleave", () => {
      hovering = false;
      render();
    });

    // Stop the loop while the tab isn't visible instead of letting it
    // accumulate timers in the background.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    margin-top: clamp(1.5rem, 6vw, 4.5rem);
    margin-bottom: calc(var(--space-7) + var(--space-4));
  }

  /* Enters as one block (image + text together), bottom-to-top. */
  .hero.reveal {
    transform: translateY(2rem);
    transition:
      opacity 600ms ease-in-out,
      transform 600ms ease-in-out;
  }

  .hero.reveal.is-visible {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero.reveal {
      transform: none;
      transition: none;
    }
  }

  .hero-illustration {
    flex: none;
    width: min(60%, 20rem);
  }

  /* Sized by the base illustration (normal flow, like a single <img> would
     be); the overlay illustration is absolutely positioned on top of it so
     both breakpoints below don't need separate overlay sizing rules. */
  .hero-illustration-frame {
    position: relative;
    width: 100%;
  }

  .hero-illustration :global(img) {
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 500ms ease-in-out;
  }

  .hero-illustration :global(img.is-active) {
    opacity: 1;
  }

  /* Crossfades over the base illustration (auto-rotation + hover state —
     see the script below). */
  .hero-illustration :global(.hero-illustration-img--overlay) {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-illustration :global(img) {
      transition: none;
    }
  }

  .hero-text {
    text-align: center;
    color: #3e3e3e;
  }

  .hero-text .latin {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
  }

  .hero-eyebrow {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-sm);
    color: #1e1e1e;
    margin-bottom: var(--space-1);
  }

  .hero-title {
    /* Floor (2rem/32px) stays comfortably above .hero-headline's fixed
       27px at every viewport — the old clamp(1.75rem, 3vw, 2.75rem) could
       shrink below the headline's size on narrower screens. */
    font-size: clamp(2rem, 4vw, 2.625rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1e1e1e;
    margin-bottom: var(--space-3);
  }

  .hero-headline {
    /* display: inline (rather than block) so the highlight background
       below wraps tightly around each line of text individually — a
       highlighter-marker effect — instead of spanning the full block width. */
    display: inline;
    color: var(--color-text);
    background-image: linear-gradient(#feffbf, #feffbf);
    background-repeat: no-repeat;
    /* Starts at 0 width and grows in on entrance (see .reveal.is-visible
       below) for a hand-drawn highlighter-sweep effect. */
    background-size: 0% 66%;
    background-position: 0 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    /* Delay covers the .hero block's slide-in (600ms) plus a 400ms pause,
       so the highlighter only sweeps in once the block has fully arrived. */
    transition: background-size 700ms ease-in-out 1000ms;
    /* Scales continuously alongside .hero-title (clamp(2rem, 4vw, 2.625rem))
       instead of a separate fixed size + single breakpoint, so the two
       don't visibly drift out of proportion as the viewport narrows. */
    font-size: clamp(20px, 2.6vw, 27px);
    font-weight: 700;
    line-height: 1.5;
  }

  .reveal.is-visible .hero-headline {
    background-size: 100% 66%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-headline {
      background-size: 100% 66%;
      transition: none;
    }
  }

  .hero-body {
    margin: var(--space-2) auto 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-1) + 16px);
    max-width: 42rem;
  }

  .hero-body p {
    font-size: 14px;
    font-weight: 400;
    line-height: 2;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .hero-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 8rem;
    height: 2.75rem;
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    border-radius: 999px;
    transition: opacity 150ms ease;
  }

  .hero-btn:hover {
    opacity: 0.85;
  }

  .hero-btn-icon {
    flex-shrink: 0;
    display: block;
  }

  .hero-btn--primary {
    background: #1e1e1e;
    color: #fefefe;
  }

  .hero-btn--secondary {
    background: #e5e5e5;
    color: #1e1e1e;
  }

  .work-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: clamp(1.5rem, 6vw, 4.5rem);
  }

  .work-icon {
    position: relative;
    flex-shrink: 0;
    width: 21px;
    height: 21px;
  }

  .work-icon::before,
  .work-icon::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    background: #3e3e3e;
  }

  .work-icon::before {
    bottom: 0;
    right: 0;
  }

  .work-icon::after {
    top: 0;
    left: 0;
    z-index: 1;
    background: #fefefe;
    border: 1px solid #3e3e3e;
  }

  .work-heading h2 {
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (min-width: 62em) {
    .work-heading h2 {
      font-size: 28px;
    }
  }

  .work-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .work-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    width: 100%;
    margin-bottom: var(--space-7);
  }

  /* Full-bleed light-gray band, matching the about page's .skills-band. */
  .section-row {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: var(--space-4);
    padding-block: clamp(5rem, 10vw, 9rem);
    padding-inline: var(--page-padding-inline);
    background: #f9f9f9;
  }

  .section-row-inner {
    max-width: calc(90rem - (var(--page-padding-inline) * 2));
    margin-inline: auto;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-icon {
    position: relative;
    flex-shrink: 0;
    width: 21px;
    height: 21px;
  }

  .section-icon::before,
  .section-icon::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    background: #3e3e3e;
  }

  .section-icon::before {
    bottom: 0;
    right: 0;
  }

  .section-icon::after {
    top: 0;
    left: 0;
    z-index: 1;
    background: #fefefe;
    border: 1px solid #3e3e3e;
  }

  .section-heading h2 {
    font-size: clamp(22px, 4.5vw, 38px);
    font-weight: 500;
    white-space: nowrap;
    margin-bottom: 0;
    color: #1e1e1e;
  }

  @media (min-width: 62em) {
    .section-heading h2 {
      font-size: 28px;
    }
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .section-heading.reveal {
    transform: translateY(1.5rem);
    transition:
      opacity 500ms ease-in-out,
      transform 500ms ease-in-out;
  }

  .section-heading.reveal.is-visible {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-heading.reveal {
      transform: none;
      transition: none;
    }
  }

  /* Grid is pre-sized for a 2x2 card layout even though only one card
     exists today — the empty cells simply collapse until more are added. */
  .side-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side-projects > li.reveal {
    transform: translateY(2rem);
    transition:
      opacity 500ms ease-in-out,
      transform 500ms ease-in-out;
  }

  .side-projects > li.reveal.is-visible {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .side-projects > li.reveal {
      transform: none;
      transition: none;
    }
  }

  .side-project {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .side-project-thumb {
    display: block;
    overflow: hidden;
    border-radius: 14px;
    background: #efefef;
    transition: box-shadow var(--transition-hover);
  }

  .side-project:hover .side-project-thumb {
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-text), transparent 88%);
  }

  .side-project-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    transition: transform 600ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .side-project:hover .side-project-cover {
    transform: scale(1.05);
  }

  .side-project-body {
    display: block;
    flex: 1;
    padding: var(--space-3) 0;
  }

  .side-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .side-project-tag {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #797979;
    background: #fefefe;
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .side-project-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.45;
    margin-bottom: var(--space-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .side-project-title .title-highlight {
    display: inline;
    background-image: linear-gradient(#feffbf, #feffbf);
    background-repeat: no-repeat;
    background-size: 0% 66%;
    background-position: 0 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-size 400ms ease-in-out;
  }

  .side-project:hover .title-highlight {
    background-size: 100% 66%;
  }

  @media (prefers-reduced-motion: reduce) {
    .side-project-title .title-highlight {
      transition: none;
    }
  }

  .side-project-summary {
    color: var(--color-text-secondary);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 40em) {
    .side-project-tag {
      font-size: 0.875rem;
    }

    .side-project-summary {
      font-size: 1rem;
    }
  }

  @media (min-width: 40em) {
    .side-projects {
      grid-template-columns: 1fr 1fr;
    }
  }

  .work-card {
    transform: translateY(2rem);
    transition:
      opacity 500ms ease-in-out,
      transform 500ms ease-in-out;
  }

  .work-card.is-visible {
    transform: translateY(0);
  }

  /* Cascades bottom-to-top, one card after another. */
  .work-card:nth-child(1) {
    transition-delay: 0ms;
  }

  .work-card:nth-child(2) {
    transition-delay: 120ms;
  }

  .work-card:nth-child(3) {
    transition-delay: 240ms;
  }

  .work-card:nth-child(4) {
    transition-delay: 360ms;
  }

  .work-card:nth-child(5) {
    transition-delay: 480ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card {
      transform: none;
      transition: none;
    }
  }

  /* From 640px up, the hero switches from centered mobile stacking to
     left-aligned — first still stacked (text above image), then as a
     side-by-side grid once there's enough width (see the 62em query). */
  @media (min-width: 40em) {
    .hero {
      align-items: flex-start;
      text-align: left;
    }

    .hero-illustration {
      margin-inline: 0;
    }

    .hero-text {
      text-align: left;
    }

    .hero-body {
      margin-inline: 0;
      max-width: none;
    }

    .hero-body p {
      font-size: var(--text-base);
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .work-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 640–992px: text above image, both left-aligned (flex-direction stays
     column from the mobile default — only alignment changes). */
  @media (min-width: 40em) and (max-width: 61.9375em) {
    .hero-illustration {
      width: min(50%, 20rem);
    }
  }

  /* ≥992px: side-by-side grid, text left / image right. */
  @media (min-width: 62em) {
    .hero {
      display: grid;
      /* Text column keeps the exact width it had with the old 8fr/4fr +
         var(--space-6) gap split (2/3 of the row, minus 2/3 of that gap) —
         removing the gap shouldn't reflow the copy, only close the empty
         strip between the two blocks. */
      grid-template-columns: calc(66.667% - 3rem) 1fr;
      align-items: center;
      gap: 0;
    }

    .hero-illustration {
      width: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-illustration-frame {
      width: 100%;
      max-width: 16rem;
    }
  }

  /* The gray .section-row band should butt straight up against the footer
     with no white strip — overrides Footer.astro's default spacer margin,
     which exists for pages that don't already end on a full-bleed band. */
  :global(footer.footer) {
    margin-top: 0 !important;
  }
</style>
