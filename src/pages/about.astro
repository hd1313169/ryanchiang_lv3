---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/photos/about-hero-portrait.png";

const facts = [
  { label: "Specialty", value: "SaaS、CRM、Web Design" },
  { label: "Experience", value: "3+ years" },
];

const email = "wsad71155@gmail.com";

const skills = [
  {
    title: "介面設計",
    description:
      "有從零建立 Design System 的經驗，也熟悉在既有規範框架內工作。設計決策不只考慮當下畫面，也考慮後續迭代的邊界。",
  },
  {
    title: "系統思考",
    description:
      "處理 RBAC 權限設計、複雜業務工作流與多角色資料可見邊界。習慣從資料結構與依賴關係出發定義設計優先序，而不是從頁面出發。",
  },
  {
    title: "跨角色協作",
    description:
      "橫跨設計、SA、PM 職責，參與需求釐清、UAT 定義與利害關係人溝通。習慣主動識別沒人負責的空白，而不是等待對口出現。",
  },
  {
    title: "AI 協作",
    description:
      "為 AI 建立分工邊界——定義哪些環節交給 AI 加速、哪些節點必須由設計判斷介入。讓工具服務決策，而不是取代它。",
  },
];

const experience = [
  {
    role: "UX/UI 設計師",
    org: "筑今數位設計",
    period: "2023 — 現在",
    description:
      "專注數位產品設計的顧問公司，負責橫跨金融、行銷、SaaS 等產業的系統設計，兼任 SA 職責，承接業務規則釐清、PRD 撰寫與工程師協作。",
  },
  {
    role: "數位行銷專員",
    org: "敦煌教育集團",
    period: "2020 — 2022",
    description: "透過數據分析與用戶問卷，建立從量化數據與質化回饋推導設計方向的工作習慣。",
  },
  {
    role: "平面設計師",
    org: "自由接案",
    period: "2019 — 2020",
    description: "接觸各產業的視覺需求，培養基礎美感判斷與需求釐清的能力。",
  },
];
---

<BaseLayout
  title="About — Ryan Chiang"
  description="很多系統設計專案的真正難點，不在介面，而在介面背後那些沒有被說清楚的規則。我習慣在這個地方多停一下，把隱形的前提找出來，讓後續的設計有真正的依據。"
>
  <article class="about">
    <section class="reveal intro-grid">
      <div class="bio">
        <p class="intro">
          我是 Ryan，UX/UI 設計師。
        </p>

        <p class="run-in">
          很多系統設計專案的真正難點，不在介面，而在介面背後那些沒有被說清楚的規則——業主知道怎麼運作，但說不出來；團隊各自有理解，但版本不同。我習慣在這個地方多停一下，把這些隱形的前提找出來，讓後續的設計有真正的依據。
        </p>

        <p class="run-in">
          在設計公司的工作經驗中，我接觸過行銷、證券、空間租借及室內裝修等不同產業的系統設計，從需求訪談、PRD 撰寫到 UAT 驗收全程參與。每個案子的業務規則都不一樣，但每次做的是同一件事：把業務規則、系統邏輯、使用情境這三層之間的落差找出來，讓介面去承載這個判斷的結果。
        </p>

        <p class="run-in">
          長期做這件事，讓我確認了一件事——設計師在複雜專案裡最大的貢獻，不在於把介面做得更精緻，而在於在夠早的地方介入，在問題定義還模糊的時候幫助把方向收斂清楚。
        </p>
      </div>

      <div class="side">
        <div class="photo">
          <Image src={portrait} alt="Ryan Chiang" width={900} />
        </div>

        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="fact">
                <dt class="fact-label">{fact.label}</dt>
                <dd class="fact-value">
                  {fact.value.split("\n").map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
          <div class="fact">
            <dt class="fact-label">Email</dt>
            <dd class="fact-value">
              <button type="button" class="email-copy" data-email={email}>
                <span class="email-copy-text">{email}</span>
              </button>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="reveal section-row">
      <h2>技能</h2>
      <dl class="skills">
        {
          skills.map((skill, i) => (
            <div class="skill">
              <dt>
                <span class="skill-num">{String(i + 1).padStart(2, "0")}</span>
                {skill.title}
              </dt>
              <dd>{skill.description}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="reveal section-row">
      <h2>經歷</h2>
      <ul class="experience">
        {
          experience.map((job) => (
            <li class="experience-item">
              <span class="experience-period">{job.period}</span>
              <span class="experience-content">
                <p class="job-title">
                  {job.role}
                  <span class="job-org">{job.org}</span>
                </p>
                <p class="job-description">{job.description}</p>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".email-copy").forEach((button) => {
    const label = button.querySelector(".email-copy-text");
    const original = label?.textContent ?? "";
    let resetTimer: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      const email = button.dataset.email ?? "";
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }

      if (label) label.textContent = "已複製";
      button.classList.add("copied");
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (label) label.textContent = original;
        button.classList.remove("copied");
      }, 1600);
    });
  });
</script>

<style>
  .about {
    width: 100%;
    padding-block: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .intro-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding-top: 40px;
  }

  .intro {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.9;
  }

  .intro::first-letter {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 2.75em;
    font-weight: 500;
    float: left;
    line-height: 0.85;
    padding-right: 0.1em;
  }

  .run-in {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.9;
  }

  .run-in-head {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-text);
    margin-right: var(--space-2);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    order: -1;
  }

  .photo {
    /* Shape the box itself, rather than the <img>, so the 16:9 ratio holds
       even before the (lazy-loaded) image has decoded. */
    aspect-ratio: 16 / 10;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .fact-label {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }

  .fact-label::after {
    content: "／";
    margin-left: 0.3em;
  }

  .fact-value {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .email-copy {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  .email-copy:hover {
    text-decoration-color: var(--color-text);
  }

  .email-copy.copied {
    color: var(--color-text-secondary);
    text-decoration-color: var(--color-border);
  }

  .section-row {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--text-md);
    font-weight: 500;
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin: 0;
  }

  .skill dt {
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .skill-num {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    margin-right: var(--space-1);
  }

  .skill dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.7;
  }

  .experience {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .experience-item {
    display: flex;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .experience-item:first-child {
    padding-top: 0;
  }

  .experience-item:last-child {
    padding-bottom: 0;
  }

  .experience-period {
    flex-shrink: 0;
    width: 6rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    padding-top: 0.2em;
  }

  .experience-content {
    flex: 1;
    min-width: 0;
  }

  .job-title {
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }

  .job-org {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .job-description {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    margin-top: var(--space-1);
  }

  @media (min-width: 40em) {
    .skills {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Medium: the persistent sidebar nav leaves too little room here for a
     comfortable bio/side split, so the side card sits above the bio as a
     compact horizontal row instead of squeezing both columns. */
  @media (min-width: 31.25em) and (max-width: 79.99em) {
    .side {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .photo {
      flex: 0 1 40%;
    }

    .facts {
      flex: 1;
      min-width: 0;
    }
  }

  @media (min-width: 80em) {
    .intro-grid {
      flex-direction: row;
      align-items: flex-start;
    }

    .bio {
      flex: 3;
    }

    .side {
      order: 0;
      flex: 2;
    }
  }
</style>
