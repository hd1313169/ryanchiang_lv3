---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/photos/about-hero-portrait.png";
import notionWorkflowCover from "../assets/photos/cover-notion-workflow.jpg";

const facts = [
  { label: "Specialty", value: "SaaS、CRM、Web Design" },
  { label: "Experience", value: "3+ years" },
];

const email = "wsad71155@gmail.com";

const skills = [
  {
    title: "介面設計",
    description:
      "有從零建立 Design System 的經驗，也熟悉在既有規範框架內工作。設計決策不只考慮當下畫面，也考慮後續迭代的邊界。",
  },
  {
    title: "系統思考",
    description:
      "處理 RBAC 權限設計、複雜業務工作流與多角色資料可見邊界。習慣從資料結構與依賴關係出發定義設計優先序，而不是從頁面出發。",
  },
  {
    title: "跨角色協作",
    description:
      "橫跨設計、SA、PM 職責，參與需求釐清、UAT 定義與跨職能溝通。在團隊中主動識別沒人負責的空白，而不是等待對口出現。",
  },
  {
    title: "AI 協作",
    description:
      "為 AI 建立分工邊界——定義哪些環節交給 AI 加速、哪些節點必須由設計判斷介入。讓工具服務決策，而不是取代它。",
  },
];

const experience = [
  {
    role: "UX/UI 設計師",
    org: "筑今數位設計",
    period: "2023 — 現在",
    description: [
      "主要負責介面與使用體驗設計，參與 30+ 專案，有多元產業系統、網站設計經驗",
      "部分專案擔任 PM 角色，負責專案時程與風險的管控",
      "有前端開發與 AI 應用的基礎，積極與開發團隊溝通協作，改善工作流程",
    ],
  },
  {
    role: "數位行銷專員",
    org: "敦煌教育集團",
    period: "2020 — 2022",
    description: "負責線上成效追蹤與廣告投放，使用 GA 分析量化數據，並透過用戶問卷蒐集質化回饋。",
  },
  {
    role: "識別設計師",
    org: "自由接案",
    period: "2019 — 2020",
    description: "聚焦品牌訴求與設計理念，協助業主設計品牌視覺。",
  },
];

const sideProjects = [
  {
    title: "Notion 專案績效管理模板",
    summary:
      "一個提供中小型團隊自動化管理的 Notion 模板，共 8 個關聯資料庫分為三層。以關聯關係與公式邏輯串聯，讓績效計算從複雜試算表變成自動化工具。",
    href: "https://honey-agate-c33.notion.site/5904b56cf7778266860b012c8da88402",
    cover: notionWorkflowCover,
  },
];
---

<BaseLayout
  title="About — Ryan Chiang"
  description="很多系統設計專案的真正難點，不在介面，而在介面背後那些沒有被說清楚的規則。我習慣在這個地方多停一下，把隱形的前提找出來，讓後續的設計有真正的依據。"
>
  <article class="about">
    <section class="reveal intro-grid">
      <div class="bio">
        <p class="intro">
          我是 Ryan，UX/UI 設計師。
        </p>

        <p class="run-in">
          面對複雜的需求，我習慣先將情境拆解成各種零件，找出隱藏其中的小問題，考慮不同情境的重新排列組合，組裝成有條理的討論架構。
        </p>

        <p class="run-in">
          跨足行銷、證券、空間租借與室內裝修等多種產業的系統與網站設計，參與從需求訪談、PRD 撰寫到 UAT 驗收的完整流程。即使跨領域的系統邏輯各異，我始終專注在「使用者行為」、「系統邏輯」與「真實情境」三者之間的落差，讓介面設計成為商業決策的載體。
        </p>

        <p class="run-in">
          當需求模糊或跨部門理解分歧時，我會迅速凝聚共識、收斂方向；設計時確保每項設計決策都有據可循，大幅降低開發團隊來回溝通的摩擦成本。對團隊而言，設計不再只是華而不實的交付物，而是推動專案前進的核心。
        </p>
      </div>

      <div class="side">
        <div class="photo">
          <Image src={portrait} alt="Ryan Chiang" width={900} />
        </div>

        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="fact">
                <dt class="fact-label">{fact.label}</dt>
                <dd class="fact-value">
                  {fact.value.split("\n").map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
          <div class="fact">
            <dt class="fact-label">Email</dt>
            <dd class="fact-value">
              <button type="button" class="email-copy" data-email={email}>
                <span class="email-copy-text">{email}</span>
              </button>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="reveal section-row">
      <h2>我的技能</h2>
      <dl class="skills">
        {
          skills.map((skill, i) => (
            <div class="skill">
              <dt>
                <span class="skill-num">{String(i + 1).padStart(2, "0")}</span>
                {skill.title}
              </dt>
              <dd>{skill.description}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="reveal section-row">
      <h2>我的經歷</h2>
      <ul class="experience">
        {
          experience.map((job) => (
            <li class="experience-item">
              <span class="experience-period">{job.period}</span>
              <span class="experience-content">
                <p class="job-title">
                  {job.role}
                  <span class="job-org">{job.org}</span>
                </p>
                {Array.isArray(job.description) ? (
                  <ul class="job-description job-description-list">
                    {job.description.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="job-description">{job.description}</p>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="reveal section-row">
      <h2>個人專案</h2>
      <ul class="side-projects">
        {
          sideProjects.map((project, i) => (
            <li>
              <a class="side-project" href={project.href} target="_blank" rel="noopener noreferrer">
                <span class="side-project-thumb">
                  <Image
                    class="side-project-cover"
                    src={project.cover}
                    alt=""
                    width={800}
                    height={450}
                  />
                </span>
                <span class="side-project-body">
                  <h3 class="side-project-title">
                    <span class="side-project-num">{String(i + 1).padStart(2, "0")}</span>
                    {project.title}
                  </h3>
                  <p class="side-project-summary">{project.summary}</p>
                  <span class="side-project-cta">查看範例模板</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".email-copy").forEach((button) => {
    const label = button.querySelector(".email-copy-text");
    const original = label?.textContent ?? "";
    let resetTimer: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      const email = button.dataset.email ?? "";
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }

      if (label) label.textContent = "已複製";
      button.classList.add("copied");
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (label) label.textContent = original;
        button.classList.remove("copied");
      }, 1600);
    });
  });
</script>

<style>
  .about {
    width: 100%;
    max-width: min(90%, 78rem);
    margin-inline: 0;
    padding-block: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Above 99em, main no longer reserves a column for the sidebar (it
     overlays instead) — see BaseLayout.astro. Clear its width here to keep
     content from sitting underneath it. */
  @media (min-width: 99em) {
    .about {
      padding-left: var(--sidebar-width);
    }
  }

  .intro-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding-top: 40px;
  }

  .intro {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.9;
  }

  .intro::first-letter {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 2.75em;
    font-weight: 500;
    float: left;
    line-height: 0.85;
    padding-right: 0.1em;
  }

  .run-in {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.9;
  }

  .run-in-head {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-text);
    margin-right: var(--space-2);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    order: -1;
  }

  .photo {
    /* Shape the box itself, rather than the <img>, so the 16:9 ratio holds
       even before the (lazy-loaded) image has decoded. */
    aspect-ratio: 16 / 10;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .fact-label {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }

  .fact-label::after {
    content: "／";
    margin-left: 0.3em;
  }

  .fact-value {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .email-copy {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  .email-copy:hover {
    text-decoration-color: var(--color-text);
  }

  .email-copy.copied {
    color: var(--color-text-secondary);
    text-decoration-color: var(--color-border);
  }

  .section-row {
    padding-top: var(--space-5);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 500;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: 0;
  }

  .skill {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text);
    border-radius: 4px;
    padding: var(--space-3);
    transition: transform var(--transition-hover), box-shadow var(--transition-hover);
  }

  .skill:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-text), transparent 88%);
  }

  .skill dt {
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .skill-num {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    margin-right: var(--space-1);
  }

  .skill dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.7;
  }

  .experience {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .experience-item {
    display: flex;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .experience-item:first-child {
    padding-top: 0;
  }

  .experience-item:last-child {
    padding-bottom: 0;
  }

  .experience-period {
    flex-shrink: 0;
    width: 6rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    padding-top: 0.2em;
  }

  .experience-content {
    flex: 1;
    min-width: 0;
  }

  .job-title {
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }

  .job-org {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .job-description {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    margin-top: var(--space-1);
  }

  .job-description-list {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding-left: 1.1em;
    list-style: disc;
  }

  /* Grid is pre-sized for a 2x2 card layout even though only one card
     exists today — the empty cells simply collapse until more are added. */
  .side-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side-project {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
  }

  .side-project-thumb {
    display: block;
  }

  .side-project-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .side-project:hover .side-project-cover {
    transform: scale(1.05);
  }

  .side-project-body {
    background: #fbfbfb;
    padding: var(--space-3);
  }

  .side-project-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    transition: color var(--transition-hover);
  }

  .side-project-num {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .side-project:hover .side-project-title {
    color: var(--color-text-secondary);
  }

  .side-project-summary {
    color: var(--color-text-secondary);
    font-weight: 300;
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .side-project-cta {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 4px;
    padding: 0.5em 1em;
    transition: opacity var(--transition-hover);
  }

  .side-project:hover .side-project-cta {
    opacity: 0.8;
  }

  @media (min-width: 40em) {
    .skills {
      grid-template-columns: 1fr 1fr;
    }

    .side-projects {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Medium: the persistent sidebar nav leaves too little room here for a
     comfortable bio/side split, so the side card sits above the bio as a
     compact horizontal row instead of squeezing both columns. */
  @media (min-width: 31.25em) and (max-width: 79.99em) {
    .side {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .photo {
      flex: 0 1 40%;
    }

    .facts {
      flex: 1;
      min-width: 0;
    }
  }

  @media (min-width: 80em) {
    .intro-grid {
      flex-direction: row;
      align-items: flex-start;
    }

    .bio {
      flex: 3;
    }

    .side {
      order: 0;
      flex: 2;
    }
  }
</style>
