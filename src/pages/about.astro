---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/photos/avatar.png";
import notionWorkflowCover from "../assets/photos/cover-notion-workflow.jpg";
import skillIcon01 from "../assets/icons/skill-01.png";
import skillIcon02 from "../assets/icons/skill-02.png";
import skillIcon03 from "../assets/icons/skill-03.png";
import skillIcon04 from "../assets/icons/skill-04.png";
import aiWorkflow from "../assets/illustrations/ai-workflow.png";

const facts = [
  { label: "Specialty", value: "SaaS、CRM、Web Design" },
  { label: "Experience", value: "4 years" },
];

const email = "wsad71155@gmail.com";

const skills = [
  {
    icon: skillIcon01,
    title: "複雜系統規劃",
    description:
      "B2B / B2C 的 SaaS 設計經驗，能將複雜邏輯和大量資訊轉譯為好上手的操作體驗與介面設計",
  },
  {
    icon: skillIcon02,
    title: "AI 工作流程",
    description:
      "從需求釐清、原型製作到使用者測試，整合 AI 工具打造自己的設計流程，縮短交付迭代的週期",
  },
  {
    icon: skillIcon03,
    title: "跨職能協作",
    description:
      "設計決策涵蓋技術可行性，與開發對齊產品目標。識別專案中的模糊地帶，主動填補空白",
  },
  {
    icon: skillIcon04,
    title: "目標導向設計",
    description:
      "釐清模糊需求，並轉化為可執行的設計目標，專注於解決問題，不會拘泥於工具或形式",
  },
];

const experience = [
  {
    role: "UI/UX Designer",
    org: "筑今數位設計股份有限公司",
    period: "2023.02 － 2026.09",
    headline: "30+ 跨領域數位產品的使用體驗與介面設計",
    bullets: [
      "主導產品的核心使用體驗規劃與視覺設計，累積超過 30 個跨領域專案經驗",
      "擔任 6 項專案的 PM 工作，負責時程安排與風險管控，負責專案全數準時結案",
      "主動與開發團隊進行跨部門溝通，協助內部工作流程改善，專案時程縮短 20%",
      "建立內部客製化專案管理工具，已被使用超過 2 年，並持續迭代更新版本",
      "建立 AI 設計工作流程，大幅加速專案前期功能規劃與驗證流程",
    ],
  },
  {
    role: "Marketing",
    org: "敦煌書局股份有限公司",
    period: "2020.07 － 2022.11",
    headline: "帶領本部門行銷的數位轉型，業績成長 20%",
    bullets: [
      "主導 10 家門市年度行銷活動，與 20 多位團隊同仁協作，實體門市年度業績提升達 200%",
      "使用 GA 收集行銷漏斗數據，制定產品優化策略，線上服務年度業績成長 20%",
      "經營 LINE 官方帳號，使用外掛模組進行分眾行銷，2 年內帳號追蹤數成長 600%",
      "蒐集用戶問卷回饋，提出網站使用體驗優化報告，並實際完成 Redesign 提案的 UI 設計",
    ],
  },
  {
    role: "Freelancer",
    org: "自由工作者",
    period: "2020.04 － Present",
    headline: "不止是設計，更提供解決問題的實踐力",
    bullets: [
      "10+ LOGO 識別、廣告 banner 與網站視覺設計經驗",
      "使用 AI 開發薪資計算工具，實際解決非月薪工作者的薪資計算問題",
      "協助規劃親子體驗課程的活動場佈與場復流程，平均準備時間縮短 20 分鐘",
    ],
  },
];

const sideProjects = [
  {
    title: "Notion 專案績效管理模板",
    summary:
      "一個提供中小型團隊自動化管理的 Notion 模板，共 8 個關聯資料庫分為三層。以關聯關係與公式邏輯串聯，讓績效計算從複雜試算表變成自動化工具。",
    href: "https://honey-agate-c33.notion.site/5904b56cf7778266860b012c8da88402",
    cover: notionWorkflowCover,
  },
];
---

<BaseLayout
  title="About — Ryan Chiang"
  description="很多系統設計專案的真正難點，不在介面，而在介面背後那些沒有被說清楚的規則。我習慣在這個地方多停一下，把隱形的前提找出來，讓後續的設計有真正的依據。"
>
  <article class="about">
    <section class="intro-grid">
      <div class="bio reveal reveal-left">
        <p class="intro">
          我是 Ryan，UI/UX Designer
        </p>

        <p class="run-in">
          來自台中的多職能設計師，有 4 年設計經驗與 2 年多的整合行銷經驗，專案中也會負責專案管理的職責。喜歡把自己的想法用 Side Project 方式實踐，也積極參加社群、課程與工作坊來拓展自己的眼界。
        </p>

        <p class="run-in">
          <span class="highlight">我認為設計師的核心價值是定義問題與提供解決方案。</span>多元的經歷背景讓我在面對挑戰時，習慣先思考透徹再動手，拆解情境找出隱藏其中的細節，再根據當下條件選擇最合適的解決方法，不會侷限於只是畫設計圖。
        </p>

        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="fact">
                <dt class="fact-label">{fact.label}</dt>
                <dd class="fact-value">
                  {fact.value.split("\n").map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
          <div class="fact">
            <dt class="fact-label">Email</dt>
            <dd class="fact-value">
              <button type="button" class="email-copy" data-email={email}>
                <span class="email-copy-text">{email}</span>
              </button>
            </dd>
          </div>
        </dl>
      </div>

      <div class="side reveal reveal-left">
        <div class="photo">
          <Image src={portrait} alt="Ryan Chiang" width={700} quality={90} />
        </div>
      </div>
    </section>

    <div class="ai-stack">
      <section class="skills-band">
        <div class="skills-band-inner">
          <div class="section-heading">
            <span class="section-icon" aria-hidden="true"></span>
            <h2>我擅長的事</h2>
            <span class="section-rule" aria-hidden="true"></span>
          </div>
          <dl class="skills">
            {
              skills.map((skill, i) => (
                <div class="skill skill-enter">
                  <Image class="skill-icon" src={skill.icon} alt="" width={280} height={280} quality={90} />
                  <dt>
                    <span class="skill-num">{String(i + 1).padStart(2, "0")}</span>
                    {skill.title}
                  </dt>
                  <dd>{skill.description}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="ai-band">
        <div class="ai-band-inner">
          <div class="section-heading ai-heading">
            <span class="section-icon ai-icon" aria-hidden="true"></span>
            <h2>AI 應用實踐高效設計</h2>
            <span class="section-rule ai-rule" aria-hidden="true"></span>
          </div>
          <p class="ai-summary">
            我持續把設計流程中目標明確的步驟自動化，從需求整理、規格產出到 Prototype
            製作，透過 Skills 與 MCP 串接實踐高效設計。
            <br />
            重複性高的工作交給 AI 跑，縮減設計與驗證的週期；我負責核心的設計與決策，將注意力放在真正需要介入的地方。
          </p>
          <button type="button" class="ai-flowchart-trigger" aria-haspopup="dialog" aria-controls="ai-lightbox">
            <Image src={aiWorkflow} alt="AI 應用實踐高效設計六步驟流程圖：需求整理與知識管理、規格產出、概念發想、UIUX 設計、Prototype 製作、交付與驗收文件產出" width={2160} />
          </button>
        </div>
      </section>
    </div>

    <section class="section-row">
      <div class="section-heading reveal">
        <span class="section-icon" aria-hidden="true"></span>
        <h2>工作經歷</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="experience">
        {
          experience.map((job) => (
            <li class="experience-item reveal">
              <div class="experience-meta">
                <p class="job-title">{job.role}</p>
                <p class="job-meta">
                  <span class="job-org">{job.org}</span>
                  <span class="job-period">{job.period}</span>
                </p>
              </div>
              <div class="experience-content">
                <p class="job-headline">
                  <span class="job-headline-highlight">{job.headline}</span>
                </p>
                <ul class="job-checklist">
                  {job.bullets.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section-row">
      <div class="section-heading reveal">
        <span class="section-icon" aria-hidden="true"></span>
        <h2>個人專案</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="side-projects">
        {
          sideProjects.map((project, i) => (
            <li class="reveal">
              <a class="side-project" href={project.href} target="_blank" rel="noopener noreferrer">
                <span class="side-project-thumb">
                  <Image
                    class="side-project-cover"
                    src={project.cover}
                    alt=""
                    width={800}
                    height={450}
                  />
                </span>
                <span class="side-project-body">
                  <h3 class="side-project-title">
                    <span class="side-project-num">{String(i + 1).padStart(2, "0")}</span>
                    {project.title}
                  </h3>
                  <p class="side-project-summary">{project.summary}</p>
                  <span class="side-project-cta">查看範例模板</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

  </article>

  <Fragment slot="overlay">
    <div class="lightbox" id="ai-lightbox" hidden>
      <button type="button" class="lightbox-close" aria-label="關閉圖片">✕</button>
      <Image src={aiWorkflow} alt="" width={3072} loading="eager" class="lightbox-image" />
    </div>
  </Fragment>
</BaseLayout>

<noscript>
  <style>
    /* .skill-enter isn't part of the shared .reveal mechanism (see the
       script below), so it needs its own no-JS fallback. */
    .skill-enter {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<script>
  document.querySelectorAll<HTMLButtonElement>(".email-copy").forEach((button) => {
    const label = button.querySelector(".email-copy-text");
    const original = label?.textContent ?? "";
    let resetTimer: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      const email = button.dataset.email ?? "";
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }

      if (label) label.textContent = "已複製";
      button.classList.add("copied");
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (label) label.textContent = original;
        button.classList.remove("copied");
      }, 1600);
    });
  });

  // The skill cards enter as soon as the page loads rather than waiting for
  // scroll-into-view (unlike the rest of the page's .reveal elements), so
  // they're triggered directly here instead of through the shared
  // IntersectionObserver in BaseLayout. The double rAF lets the browser
  // paint the initial (hidden) state first so the transition actually runs.
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.querySelectorAll(".skill-enter").forEach((el) => el.classList.add("is-visible"));
    });
  });

  const lightbox = document.getElementById("ai-lightbox");
  const trigger = document.querySelector<HTMLButtonElement>(".ai-flowchart-trigger");
  const closeButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
  let lastFocused: HTMLElement | null = null;

  const openLightbox = () => {
    if (!lightbox) return;
    lastFocused = document.activeElement as HTMLElement | null;
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
    closeButton?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = "";
    lastFocused?.focus();
  };

  trigger?.addEventListener("click", openLightbox);
  closeButton?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
  });
</script>

<style>
  .about {
    width: 100%;
    padding-block: clamp(1.5rem, 4vw, 2rem) clamp(3rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .intro-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 4vw, 3rem);
  }

  /* Text and photo enter together (both left-to-right), then the
     highlighter sweeps in 200ms after they finish (see .highlight). */
  .reveal-left {
    transform: translateX(-3rem);
    transition:
      opacity 600ms ease-in-out,
      transform 600ms ease-in-out;
  }

  .reveal-left.is-visible {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-left {
      transform: none;
      transition: none;
    }
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding-top: 40px;
  }

  .intro {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: clamp(1.5rem, 5vw, 2.1875rem);
    font-weight: 600;
    line-height: 1.2;
    color: #1e1e1e;
  }

  .run-in {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
  }

  /* .bio's flex `gap` (var(--space-3), 24px) is wider than wanted between
     the two intro paragraphs specifically — pull just that pair closer
     without affecting the gap before/after them. */
  .run-in + .run-in {
    margin-top: calc(12px - var(--space-3));
  }

  .highlight {
    display: inline;
    color: var(--color-text);
    background-image: linear-gradient(#feffbf, #feffbf);
    background-repeat: no-repeat;
    /* Starts at 0 width and grows in on entrance (see .reveal.is-visible
       below) for a hand-drawn highlighter-sweep effect. */
    background-size: 0% 66%;
    background-position: 0 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    font-weight: 500;
    /* Starts once the text/photo slide-in (600ms) plus a 200ms pause has
       elapsed: 600 + 200 = 800ms. */
    transition: background-size 700ms ease-in-out 800ms;
  }

  .reveal.is-visible .highlight {
    background-size: 100% 66%;
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight {
      background-size: 100% 66%;
      transition: none;
    }
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: center;
    order: -1;
  }

  .photo {
    width: clamp(9rem, 45vw, 14rem);
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .facts {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1rem, 4vw, 2rem);
    margin: 0;
    padding-top: 0;
  }

  @media (min-width: 30em) {
    .facts {
      flex-direction: row;
    }
  }

  .fact-label {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }

  .fact-value {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
  }

  .email-copy {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  .email-copy:hover {
    text-decoration-color: var(--color-text);
  }

  .email-copy.copied {
    color: var(--color-text-secondary);
    text-decoration-color: var(--color-border);
  }

  .section-row {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-icon {
    position: relative;
    flex-shrink: 0;
    width: 21px;
    height: 21px;
  }

  .section-icon::before,
  .section-icon::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    background: #3e3e3e;
  }

  .section-icon::before {
    bottom: 0;
    right: 0;
  }

  .section-icon::after {
    top: 0;
    left: 0;
    z-index: 1;
    background: #fefefe;
    border: 1px solid #3e3e3e;
  }

  .section-heading h2 {
    font-size: clamp(22px, 4.5vw, 38px);
    font-weight: 500;
    white-space: nowrap;
    margin-bottom: 0;
    color: #1e1e1e;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .section-heading.reveal {
    transform: translateY(1.5rem);
    transition:
      opacity 500ms ease-in-out,
      transform 500ms ease-in-out;
  }

  .section-heading.reveal.is-visible {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-heading.reveal {
      transform: none;
      transition: none;
    }
  }

  /* Wraps .skills-band and .ai-band together so .skills-band's sticky range
     (see below) is bounded by this wrapper's height — i.e. exactly the
     combined height of both bands, not the rest of the page. */
  .ai-stack {
    position: relative;
  }

  /* Breaks out of .about's centered column to span the full viewport width,
     regardless of how deeply nested the section is. Sticky (desktop only —
     see the min-width: 40em override below) at the top of .ai-stack so
     .ai-band (below) can visually slide up and cover it as the page scrolls
     — see .ai-band's comment for the other half of that effect. On mobile,
     the single-column skills list is taller than the viewport; since a
     sticky element that's taller than the viewport can't be scrolled
     internally, pinning it there would freeze it before its lower cards
     ever become visible, so mobile gets plain, unpinned flow instead. */
  .skills-band {
    position: static;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: var(--space-4);
    padding-block: clamp(5rem, 10vw, 9rem);
    padding-inline: var(--page-padding-inline);
    background: #f9f9f9;
  }

  /* Subtracting the band's own inline padding (twice, already applied above)
     from the same 90rem cap <main> uses keeps this content's left/right
     edges flush with the bio/experience content above and below it. */
  .skills-band-inner {
    max-width: calc(90rem - (var(--page-padding-inline) * 2));
    margin-inline: auto;
  }

  /* Sits flush under .skills-band (no gap) with a higher stacking order and
     an opaque background, so as the page scrolls it rises up over the still
     -pinned .skills-band above, fully covering it before .ai-stack ends and
     normal scrolling resumes into 工作經歷 (desktop only — see .skills-band's
     comment on why mobile skips the sticky pin; min-height: 100vh is only
     needed to keep that cover convincing, so it's desktop-only too). */
  .ai-band {
    position: relative;
    z-index: 2;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7rem);
    padding-inline: var(--page-padding-inline);
    background: #1e1e1e;
  }

  .ai-band-inner {
    max-width: calc(90rem - (var(--page-padding-inline) * 2));
    margin-inline: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Light-on-dark variant of .section-heading for use on .ai-band's black
     background. Its default margin-bottom (var(--space-6), sized for the
     larger content grids under 我擅長的事/工作經歷) is far more than this
     two-line summary needs. */
  .ai-heading {
    margin-bottom: clamp(1.5rem, 5vw, 2.5rem);
  }

  .ai-heading h2 {
    color: #f0efec;
  }

  .ai-icon::before {
    background: #f0efec;
  }

  .ai-icon::after {
    background: #1e1e1e;
    border-color: #f0efec;
  }

  .ai-rule {
    background: #3a3a3a;
  }

  .ai-summary {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    color: #ffffff;
