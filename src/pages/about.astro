---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/photos/avatar.png";
import skillIcon01 from "../assets/icons/skill-01.png";
import skillIcon02 from "../assets/icons/skill-02.png";
import skillIcon03 from "../assets/icons/skill-03.png";
import skillIcon04 from "../assets/icons/skill-04.png";
import aiWorkflow from "../assets/illustrations/ai-workflow.png";
import communityOnline from "../assets/photos/about-community-online.png";
import communityOffline from "../assets/photos/about-community-offline.png";

const facts = [
  { label: "Specialty", value: "B2B / B2C 系統、CRM、Web Design" },
  { label: "Experience", value: "4 years" },
];

const email = "wsad71155@gmail.com";

const skills = [
  {
    icon: skillIcon01,
    title: "系統與流程設計",
    description:
      "具備 B2B、B2C 與 SaaS 系統設計經驗，能將業務規則與大量資訊轉譯為好上手的操作流程與介面設計",
  },
  {
    icon: skillIcon02,
    title: "AI 工作流程",
    description:
      "從需求釐清、原型製作到使用者測試，整合 AI 工具打造自己的設計流程，縮短交付迭代的週期",
  },
  {
    icon: skillIcon03,
    title: "跨職能協作",
    description:
      "設計決策涵蓋技術可行性，與開發對齊產品目標。識別專案中的模糊地帶，主動填補空白",
  },
  {
    icon: skillIcon04,
    title: "目標導向設計",
    description:
      "釐清模糊需求，並轉化為可執行的設計目標，專注於解決問題，不會拘泥於工具或形式",
  },
];

const experience = [
  {
    role: "UI/UX Designer",
    org: "筑今數位設計股份有限公司",
    period: "2023.02 － 2026.09",
    headline: "約 30 個專案的使用體驗與介面設計，涵蓋系統、官網、電商等類型",
    bullets: [
      "主導產品的核心使用體驗規劃與視覺設計，累積約 30 個專案的 UI/UX 設計經驗",
      "主導約 10 個 B2B、B2C 與 SaaS 系統的使用體驗規劃與 Prototype 製作",
      "擔任 6 項專案的 PM 工作，負責時程安排與風險管控，所有專案全數準時結案",
      "主動與開發團隊進行跨部門溝通，協助內部工作流程改善",
      "建立內部客製化專案管理工具，已被使用超過 2 年，並持續迭代更新版本",
      "以 Claude Code 結合 Figma MCP 與 OpenSpec 建立設計工作流，將需求整理至原型交付週期縮短 1-2 週",
    ],
  },
  {
    role: "Marketing",
    org: "敦煌書局股份有限公司",
    period: "2020.07 － 2022.11",
    headline: "以數據與用戶回饋驅動行銷優化，線上服務業績成長 20%",
    bullets: [
      "主導 10 家門市年度行銷活動，與 20 多位團隊同仁協作，實體門市年度業績增長 1 倍",
      "使用 GA 收集行銷漏斗數據，制定產品優化策略，線上服務年度業績成長 20%",
      "經營 LINE 官方帳號，使用外掛模組進行分眾行銷，2 年內追蹤數從 4,000 人成長至超過 24,000 人，封鎖率低於 6%",
      "蒐集用戶問卷回饋，提出網站使用體驗優化報告，並實際完成 Redesign 提案的 UI 設計",
    ],
  },
  {
    role: "Freelancer",
    org: "自由工作者",
    period: "2020.04 － Present",
    headline: "不止是設計，更提供解決問題的實踐力",
    bullets: [
      "10 + 網站視覺、LOGO、廣告 Banner 設計專案",
      "使用 AI coding 開發工具，實際解決生活中的問題",
    ],
  },
];

const communityCards = [
  { image: communityOnline, caption: "工作坊 & Side Project" },
  { image: communityOffline, caption: "曼陀號第 8 屆 UI/UX 組" },
];

---

<BaseLayout
  buildAnim="about"
  title="About — Ryan Chiang"
  description="很多系統設計專案的真正難點，不在介面，而在介面背後那些沒有被說清楚的規則。我習慣在這個地方多停一下，把隱形的前提找出來，讓後續的設計有真正的依據。"
>
  <article class="about">
    <section class="intro-grid" data-build-section="once">
      <div class="bio">
        <p class="intro" data-build="text" data-group="intro">
          我是 Ryan，UI/UX Designer
        </p>

        <p class="run-in" data-build="text" data-group="intro">
          來自台中的多職能設計師，有 4 年設計經驗與 2 年多的整合行銷經驗，專案中也會負責專案管理的職責。喜歡把自己的想法用 Side Project 方式實踐，也積極參加社群、課程與工作坊來拓展自己的眼界。
        </p>

        <p class="run-in" data-build="text" data-group="intro">
          <span class="highlight">我認為設計師的核心價值是定義問題與提供解決方案。</span>多元的經歷背景讓我在面對挑戰時，習慣先思考透徹再動手，拆解情境找出隱藏其中的細節，再根據當下條件選擇最合適的解決方法，不會侷限於只是畫設計圖。
        </p>

        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="fact">
                <dt class="fact-label" data-build="text" data-group="facts">{fact.label}</dt>
                <dd class="fact-value" data-build="text" data-group="facts">
                  {fact.value.split("\n").map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
          <div class="fact">
            <dt class="fact-label" data-build="text" data-group="facts">Email</dt>
            <dd class="fact-value">
              <button type="button" class="email-copy" data-email={email} data-build="button" data-group="facts">
                <span class="email-copy-text">{email}</span>
              </button>
            </dd>
          </div>
        </dl>
      </div>

      <div class="side">
        <div class="photo" data-build="block" data-group="photo">
          <Image src={portrait} alt="Ryan Chiang" width={700} quality={90} />
        </div>
      </div>
    </section>

    <div class="ai-stack">
      <section class="skills-band" data-build-section="scrub">
        <div class="skills-band-inner">
          <div class="section-heading">
            <span class="section-icon" aria-hidden="true" data-build="block" data-group="heading"></span>
            <h2 data-build="text" data-group="heading">我擅長的事</h2>
            <span class="section-rule" aria-hidden="true" data-build="block" data-group="heading"></span>
          </div>
          <dl class="skills">
            {
              skills.map((skill, i) => (
                <div class="skill">
                  <Image
                    class="skill-icon"
                    src={skill.icon}
                    alt=""
                    width={280}
                    height={280}
                    quality={90}
                    data-build="block"
                    data-group={`skill-${i + 1}`}
                    data-label={`Skill ${String(i + 1).padStart(2, "0")}`}
                  />
                  <dt data-build="text" data-group={`skill-${i + 1}`}>
                    <span class="skill-num">{String(i + 1).padStart(2, "0")}</span>
                    {skill.title}
                  </dt>
                  <dd data-build="text" data-group={`skill-${i + 1}`}>{skill.description}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="ai-band" data-build-section="scrub" data-build-theme="dark">
        <div class="ai-band-inner">
          <div class="section-heading ai-heading">
            <span class="section-icon ai-icon" aria-hidden="true" data-build="block" data-group="heading"></span>
            <h2 data-build="text" data-group="heading">AI 應用實踐高效設計</h2>
            <span class="section-rule ai-rule" aria-hidden="true" data-build="block" data-group="heading"></span>
          </div>
          <p class="ai-summary" data-build="text" data-group="summary">
            我持續把設計流程中目標明確的步驟自動化，從需求整理、規格產出到 Prototype
            製作，透過 Skills 與 MCP 串接實踐高效設計。
            <br />
            重複性高的工作交給 AI 跑，縮減設計與驗證的週期；我負責核心的設計與決策，將注意力放在真正需要介入的地方。
          </p>
          <button
            type="button"
            class="ai-flowchart-trigger"
            aria-haspopup="dialog"
            aria-controls="ai-lightbox"
            data-build="block" data-group="flow"
            data-label="Workflow"
          >
            <Image src={aiWorkflow} alt="AI 應用實踐高效設計六步驟流程圖：需求整理與知識管理、規格產出、概念發想、UI/UX 設計、Prototype 製作、交付與驗收文件產出" width={2160} quality={90} />
          </button>
        </div>
      </section>
    </div>

    <section class="section-row" data-build-section="scrub">
      <div class="section-heading">
        <span class="section-icon" aria-hidden="true" data-build="block" data-group="heading"></span>
        <h2 data-build="text" data-group="heading">工作經歷</h2>
        <span class="section-rule" aria-hidden="true" data-build="block" data-group="heading"></span>
      </div>
      <ul class="experience">
        {
          experience.map((job, i) => (
            <li class="experience-item">
              <div class="experience-meta">
                <p class="job-title" data-build="text" data-group={`job-${i + 1}`} data-label={`Job ${String(i + 1).padStart(2, "0")}`}>{job.role}</p>
                <p class="job-meta" data-build="text" data-group={`job-${i + 1}`}>
                  <span class="job-org">{job.org}</span>
                  <span class="job-period">{job.period}</span>
                </p>
              </div>
              <div class="experience-content">
                <p class="job-headline" data-build="text" data-group={`job-${i + 1}`}>
                  <span class="job-headline-highlight">{job.headline}</span>
                </p>
                <ul class="job-checklist" data-build="text" data-group={`job-${i + 1}`}>
                  {job.bullets.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="community-band-clip">
      <section class="community-band" data-build-section="scrub">
        <div class="community-band-inner">
          <div class="section-heading">
            <span class="section-icon" aria-hidden="true" data-build="block" data-group="heading"></span>
            <h2 data-build="text" data-group="heading">積極參與設計社群與課程</h2>
            <span class="section-rule" aria-hidden="true" data-build="block" data-group="heading"></span>
          </div>
          <ul class="community-cards">
            <span class="community-glow community-glow-left" aria-hidden="true"></span>
            <span class="community-glow community-glow-right" aria-hidden="true"></span>
            {
              communityCards.map((card, i) => (
                <li class="community-card">
                  <div
                    class="community-card-image"
                    data-build="block"
                    data-group={`community-${i + 1}`}
                    data-label={`Card ${String(i + 1).padStart(2, "0")}`}
                  >
                    <Image src={card.image} alt="" width={1200} quality={90} />
                  </div>
                  <p class="community-card-caption" data-build="text" data-group={`community-${i + 1}`}>{card.caption}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

  </article>

  <Fragment slot="overlay">
    <div class="lightbox" id="ai-lightbox" hidden>
      <button type="button" class="lightbox-close" aria-label="關閉圖片">✕</button>
      <Image src={aiWorkflow} alt="" width={3072} quality={90} loading="eager" class="lightbox-image" />
    </div>
  </Fragment>
</BaseLayout>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { startBuildAnimations } from "../build-anim";

  gsap.registerPlugin(ScrollTrigger);

  // 疊蓋轉場（原本是 CSS sticky）：桌機上「我擅長的事」停在畫面頂端，
  // 深色的 AI 區塊往上捲時把它整個蓋住，然後正常捲動。
  // 區段比畫面高時不釘住，否則下方的卡片會在被看到之前就被蓋掉。
  const skillsBand = document.querySelector<HTMLElement>(".skills-band");
  const aiBand = document.querySelector<HTMLElement>(".ai-band");
  if (skillsBand && aiBand) {
    gsap.matchMedia().add("(min-width: 40em)", () => {
      if (skillsBand.offsetHeight > window.innerHeight) return;
      const st = ScrollTrigger.create({
        trigger: skillsBand,
        start: "top top",
        endTrigger: aiBand,
        end: "top top",
        pin: true,
        pinSpacing: false,
      });
      return () => st.kill();
    });
  }

  startBuildAnimations();
</script>

<script>
  document.querySelectorAll<HTMLButtonElement>(".email-copy").forEach((button) => {
    const label = button.querySelector(".email-copy-text");
    const original = label?.textContent ?? "";
    let resetTimer: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      const email = button.dataset.email ?? "";
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }

      if (label) label.textContent = "已複製";
      button.classList.add("copied");
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (label) label.textContent = original;
        button.classList.remove("copied");
      }, 1600);
    });
  });

  const lightbox = document.getElementById("ai-lightbox");
  const trigger = document.querySelector<HTMLButtonElement>(".ai-flowchart-trigger");
  const closeButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
  let lastFocused: HTMLElement | null = null;

  const openLightbox = () => {
    if (!lightbox) return;
    lastFocused = document.activeElement as HTMLElement | null;
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
    closeButton?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = "";
    lastFocused?.focus();
  };

  trigger?.addEventListener("click", openLightbox);
  closeButton?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
  });
</script>

<style>
  .about {
    width: 100%;
    /* No bottom padding: the page always ends in .community-band-clip now,
       which provides its own 160px padding-bottom as the page's closing
       whitespace — an extra value here would just stack on top of it. */
    padding-block: clamp(1.5rem, 4vw, 2rem) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .intro-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 4vw, 3rem);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding-top: 40px;
  }

  .intro {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: clamp(1.5rem, 5vw, 2.1875rem);
    font-weight: 600;
    line-height: 1.2;
    color: #1e1e1e;
  }

  .run-in {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.9;
  }

  /* .bio's flex `gap` (var(--space-3), 24px) is wider than wanted between
     the two intro paragraphs specifically — pull just that pair closer
     without affecting the gap before/after them. */
  .run-in + .run-in {
    margin-top: calc(12px - var(--space-3));
  }

  .highlight {
    display: inline;
    color: var(--color-text);
    background-image: linear-gradient(#feffbf, #feffbf);
    background-repeat: no-repeat;
    /* Starts at 0 width and sweeps in once the intro has finished building
       (.ba-done, set by src/build-anim) for a hand-drawn highlighter effect. */
    background-size: 0% 66%;
    background-position: 0 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    font-weight: 500;
    transition: background-size 700ms ease-in-out 200ms;
  }

  .intro-grid.ba-done .highlight,
  :global(html:not(.js)) .highlight {
    background-size: 100% 66%;
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight {
      background-size: 100% 66%;
      transition: none;
    }
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: center;
    order: -1;
  }

  .photo {
    width: clamp(9rem, 45vw, 14rem);
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .facts {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1rem, 4vw, 2rem);
    margin: 0;
    padding-top: 0;
  }

  @media (min-width: 30em) {
    .facts {
      flex-direction: row;
    }
  }

  .fact-label {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }

  .fact-value {
    font-family: var(--font-latin), var(--font-cjk), sans-serif;
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
  }

  .email-copy {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  .email-copy:hover {
    text-decoration-color: var(--color-text);
  }

  .email-copy.copied {
    color: var(--color-text-secondary);
    text-decoration-color: var(--color-border);
  }

  .section-row {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-icon {
    position: relative;
    flex-shrink: 0;
    width: 21px;
    height: 21px;
  }

  .section-icon::before,
  .section-icon::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    background: #3e3e3e;
  }

  .section-icon::before {
    bottom: 0;
    right: 0;
  }

  .section-icon::after {
    top: 0;
    left: 0;
    z-index: 1;
    background: #fefefe;
    border: 1px solid #3e3e3e;
  }

  .section-heading h2 {
    font-size: clamp(22px, 4.5vw, 38px);
    font-weight: 600;
    white-space: nowrap;
    margin-bottom: 0;
    color: #1e1e1e;
  }

  @media (min-width: 62em) {
    .section-heading h2 {
      font-size: 28px;
    }
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* Wraps .skills-band and .ai-band. (They used to share a CSS sticky
     cover transition; both now enter through the build animation.) */
  .ai-stack {
    position: relative;
  }

  /* Breaks out of .about's centered column to span the full viewport width,
     regardless of how deeply nested the section is. */
  .skills-band {
    position: static;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: var(--space-4);
    padding-block: clamp(5rem, 10vw, 9rem);
    padding-inline: var(--page-padding-inline);
    background: #f9f9f9;
  }

  /* Subtracting the band's own inline padding (twice, already applied above)
     from the same 90rem cap <main> uses keeps this content's left/right
     edges flush with the bio/experience content above and below it. */
  .skills-band-inner {
    max-width: calc(90rem - (var(--page-padding-inline) * 2));
    margin-inline: auto;
  }

  /* Full-bleed dark band sitting flush under .skills-band. */
  .ai-band {
    position: relative;
    z-index: 2;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7rem);
    padding-inline: var(--page-padding-inline);
    background: #1e1e1e;
  }

  .ai-band-inner {
    max-width: calc(90rem - (var(--page-padding-inline) * 2));
    margin-inline: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Light-on-dark variant of .section-heading for use on .ai-band's black
     background. Its default margin-bottom (var(--space-6), sized for the
     larger content grids under 我擅長的事/工作經歷) is far more than this
     two-line summary needs. */
  .ai-heading {
    margin-bottom: clamp(1.5rem, 5vw, 2.5rem);
  }

  .ai-heading h2 {
    color: #f0efec;
